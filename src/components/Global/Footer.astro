---
import { Image } from "astro:assets";
import logo from "@/assets/logo/favicon.webp";
import { SITE_NAME, SCHEDULE_URL } from "@/consts.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;
const scheduleExternal = SCHEDULE_URL.startsWith("http");
---

{
  render && (
    <footer class="footer_wrap">
      <div class="footer_inner">
        <div class="footer_top">
          <a class="footer_logo" href="/" aria-label={SITE_NAME}>
            <Image src={logo} alt="" width={48} height={48} loading="lazy" />
            <span>Kigudev</span>
          </a>
          <nav aria-label="Footer">
            <ul class="footer_links">
              <li>
                <span class="footer_link">
                  <i class="ph ph-instagram-logo" aria-hidden="true" />{" "}
                  Instagram
                </span>
              </li>
              <li>
                <a
                  class="footer_link"
                  href={SCHEDULE_URL}
                  target={scheduleExternal ? "_blank" : undefined}
                  rel={scheduleExternal ? "noopener noreferrer" : undefined}
                >
                  <i class="ph ph-calendar-dots" aria-hidden="true" /> Schedule
                  a Call
                </a>
              </li>
            </ul>
          </nav>
        </div>
        <div class="footer_bottom">
          <p class="footer_copyright text-style-small">
            &copy; <span id="year">{new Date().getFullYear()}</span>&#160;
            {SITE_NAME}
          </p>
        </div>
      </div>
    </footer>
  )
}

<script>
  const year = document.querySelector<HTMLSpanElement>("#year");

  if (year) {
    year.textContent = new Date().getFullYear().toString();
  }
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding: 2rem var(--site-margin) 3rem;
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      border-top: 0;
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .footer_top {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4) var(--space-6);
    }

    .footer_logo {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      width: auto;
      max-width: 100%;
      color: var(--text);
      font-weight: 500;
      text-decoration: none;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.6;
        }
      }
    }
    .footer_logo img {
      width: 2rem;
      height: 2rem;
      object-fit: contain;
    }
    [data-theme="light"] .footer_logo img {
      filter: brightness(0) saturate(100%) invert(12%) sepia(22%)
        saturate(1307%) hue-rotate(169deg) brightness(90%);
    }

    .footer_links {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-4);
      font-family: var(--display-family);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
    }

    .footer_link {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      color: var(--text-2);
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .footer_bottom {
      padding-top: 1.25rem;
      border-top: var(--border-width) solid var(--border);
    }

    .footer_copyright {
      color: var(--text-2);
    }
  }
</style>
