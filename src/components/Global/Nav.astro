---
import { Image } from "astro:assets";
import logo from "@/assets/logo/favicon.webp";
import { SITE_NAME, SCHEDULE_URL } from "@/consts.ts";
interface Props {
  render?: boolean;
  overlap?: boolean;
}
const { render = true } = Astro.props;
---

{
  render && (
    <header class="nav_wrap">
      <a class="nav_logo" href="/" aria-label={SITE_NAME}>
        <>
          <Image src={logo} alt="" width={40} height={40} loading="eager" />
          <span>KIGUDEV</span>
        </>
      </a>
      <button
        class="nav_toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="nav-menu"
      >
        <>
          <i class="ph ph-list" aria-hidden="true" />
          <span>Menu</span>
        </>
      </button>
      <nav class="nav_menu" id="nav-menu" aria-label="Main navigation">
        <>
          <a href="/#services">Services</a>
          <a href="/#work">Projects</a>
          <a href="/#about">About</a>
          <div class="nav_mobile_theme" role="group" aria-label="Color theme">
            <button
              type="button"
              data-theme-choice="light"
              aria-label="Use light theme"
              aria-pressed="false"
            >
              <i class="ph ph-sun" aria-hidden="true" />
            </button>
            <button
              type="button"
              data-theme-choice="dark"
              aria-label="Use dark theme"
              aria-pressed="false"
            >
              <i class="ph ph-moon" aria-hidden="true" />
            </button>
          </div>
        </>
      </nav>
      <div class="nav_actions">
        <>
          <div class="nav_theme" role="group" aria-label="Color theme">
            <>
              <button
                type="button"
                data-theme-choice="light"
                aria-label="Use light theme"
                aria-pressed="false"
              >
                <i class="ph ph-sun" aria-hidden="true" />
              </button>
              <button
                type="button"
                data-theme-choice="dark"
                aria-label="Use dark theme"
                aria-pressed="false"
              >
                <i class="ph ph-moon" aria-hidden="true" />
              </button>
            </>
          </div>
          <a
            class="nav_cta"
            href={SCHEDULE_URL}
            target="_blank"
            rel="noopener noreferrer"
          >
            <>
              <span>Let’s talk</span>
              <i class="ph ph-arrow-up-right" aria-hidden="true" />
            </>
          </a>
        </>
      </div>
    </header>
  )
}
<script>
  const initializeNav = () => {
    const nav = document.querySelector<HTMLElement>(".nav_wrap");
    const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");
    if (!nav || !toggle) return;
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };
    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    nav
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        setOpen(false);
        toggle.focus();
      }
    });
    const buttons = nav.querySelectorAll<HTMLButtonElement>(
      "[data-theme-choice]",
    );
    const setTheme = (theme: "light" | "dark") => {
      document.documentElement.dataset.theme = theme;
      localStorage.setItem("kigudev-theme", theme);
      buttons.forEach((button) =>
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.themeChoice === theme),
        ),
      );
    };
    buttons.forEach((button) =>
      button.addEventListener("click", () =>
        setTheme(button.dataset.themeChoice as "light" | "dark"),
      ),
    );
    setTheme(
      document.documentElement.dataset.theme === "light" ? "light" : "dark",
    );
  };
  initializeNav();
  document.addEventListener("astro:page-load", initializeNav);
</script>
<style is:global>
  @layer components {
    .nav_wrap {
      position: fixed;
      z-index: 100;
      top: 0.75rem;
      left: 50%;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      width: min(calc(100% - 1.5rem), 86rem);
      gap: 1rem;
      transform: translateX(-50%);
      pointer-events: none;
    }
    .nav_wrap > * {
      pointer-events: auto;
    }
    .nav_logo,
    .nav_menu,
    .nav_actions,
    .nav_toggle {
      border: 0.0625rem solid rgb(255 255 255 / 10%);
      background: #171c27;
      box-shadow: 0 0.6rem 2rem rgb(7 23 34 / 12%);
      backdrop-filter: blur(1rem);
    }
    .nav_logo {
      display: inline-flex;
      width: fit-content;
      min-height: 3rem;
      align-items: center;
      gap: 0.55rem;
      padding: 0.25rem 0.85rem 0.25rem 0.25rem;
      border-radius: 100vw;
      color: #f4f7f8;
      font:
        700 1rem/1 "Barlow Condensed",
        var(--display-family);
      letter-spacing: 0.02em;
      text-decoration: none;
    }
    .nav_logo img {
      width: 2.35rem;
      height: 2.35rem;
      border-radius: 50%;
    }
    .nav_menu {
      justify-self: center;
      display: flex;
      align-items: center;
      gap: 1.5rem;
      min-height: 3rem;
      padding-inline: 1.4rem;
      border-radius: 100vw;
    }
    .nav_menu a {
      color: #f4f7f8;
      font-size: 0.85rem;
      text-decoration: none;
    }
    .nav_menu a:hover {
      color: #62d0dc;
    }
    .nav_actions {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0.25rem;
      border-radius: 100vw;
    }
    .nav_theme {
      display: flex;
    }
    .nav_theme button {
      display: grid;
      width: 2.35rem;
      aspect-ratio: 1;
      place-items: center;
      border: 0;
      border-radius: 50%;
      color: rgb(244 247 248 / 62%);
      background: transparent;
    }
    .nav_theme button[aria-pressed="true"] {
      color: #071722;
      background: #f4f7f8;
    }
    .nav_cta {
      display: flex;
      min-height: 2.5rem;
      align-items: center;
      gap: 0.55rem;
      padding-inline: 1rem 0.75rem;
      border-radius: 100vw;
      color: #eef0e8;
      background: #116f86;
      font-weight: 650;
      text-decoration: none;
      white-space: nowrap;
    }
    .nav_cta:active {
      transform: scale(0.98);
    }
    .nav_toggle {
      display: none;
    }
    .nav_mobile_theme {
      display: none;
    }
    @media (width < 48rem) {
      .nav_wrap {
        grid-template-columns: 1fr auto;
      }
      .nav_toggle {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 3rem;
        border-radius: 100vw;
        padding-inline: 1rem;
        color: var(--text);
      }
      .nav_menu {
        position: absolute;
        top: 3.6rem;
        right: 0;
        display: grid;
        width: min(18rem, calc(100vw - 1.5rem));
        justify-items: start;
        padding: 1.25rem;
        border-radius: 1rem;
        opacity: 0;
        visibility: hidden;
        transform: translateY(-0.5rem);
        transition:
          opacity 180ms,
          transform 180ms,
          visibility 0s 180ms;
      }
      .nav_wrap.open .nav_menu {
        opacity: 1;
        visibility: visible;
        transform: none;
        transition-delay: 0s;
      }
      .nav_menu a {
        width: 100%;
        padding: 0.55rem;
        font:
          700 2rem/1 "Barlow Condensed",
          sans-serif;
        text-transform: uppercase;
      }
      .nav_mobile_theme {
        display: flex;
        gap: 0.35rem;
        margin-top: 0.75rem;
        padding-top: 1rem;
        border-top: 0.0625rem solid rgb(255 255 255 / 16%);
      }
      .nav_mobile_theme button {
        display: grid;
        width: 2.5rem;
        aspect-ratio: 1;
        place-items: center;
        border: 0;
        border-radius: 50%;
        color: rgb(244 247 248 / 68%);
        background: transparent;
      }
      .nav_mobile_theme button[aria-pressed="true"] {
        color: #071722;
        background: #f4f7f8;
      }
      .nav_actions {
        display: none;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .nav_menu {
        transition: none;
      }
    }
  }
</style>
