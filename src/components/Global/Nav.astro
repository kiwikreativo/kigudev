---
import { Image } from "astro:assets";
import logo from "@/assets/logo/favicon.webp";
import { SITE_NAME, SCHEDULE_URL } from "@/consts.ts";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
  /** Fix the nav over the page rather than keeping it sticky in flow. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
const links = [
  ["Work", "#work"],
  ["Services", "#services"],
  ["About", "#about"],
  ["FAQ", "#faq"],
];
const scheduleExternal = SCHEDULE_URL.startsWith("http");
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>
          <Image src={logo} alt="" width={44} height={44} loading="eager" />
          <span>Kigudev</span>
        </a>
        <button
          class="nav_toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <>
            <i class="ph ph-list nav_toggle_open" aria-hidden="true" />
            <i class="ph ph-x nav_toggle_close" aria-hidden="true" />
          </>
        </button>
        <nav class="nav_menu" id="nav-menu" aria-label="Main navigation">
          <div class="nav_menu_inner">
            <ol class="nav_links">
              {links.map(([label, href], index) => (
                <li>
                  <span class="nav_index">0{index + 1}</span>
                  <a class="nav_link" href={href}>
                    {label}
                  </a>
                </li>
              ))}
              <li class="nav_mobile_contact">
                <>
                  <span class="nav_index">05</span>
                  <a
                    class="nav_link"
                    href={SCHEDULE_URL}
                    target={scheduleExternal ? "_blank" : undefined}
                    rel={scheduleExternal ? "noopener noreferrer" : undefined}
                  >
                    Schedule a Call
                  </a>
                </>
              </li>
            </ol>
          </div>
        </nav>
        <div class="nav_theme" role="group" aria-label="Color theme">
          <button
            type="button"
            data-theme-choice="light"
            aria-label="Use light theme"
            aria-pressed="false"
          >
            <i class="ph ph-sun" aria-hidden="true" />
          </button>
          <button
            type="button"
            data-theme-choice="dark"
            aria-label="Use dark theme"
            aria-pressed="false"
          >
            <i class="ph ph-moon" aria-hidden="true" />
          </button>
        </div>
        <a
          class="nav_cta"
          href={SCHEDULE_URL}
          target={scheduleExternal ? "_blank" : undefined}
          rel={scheduleExternal ? "noopener noreferrer" : undefined}
        >
          <i class="ph ph-calendar-dots" aria-hidden="true" /> Schedule a Call
        </a>
      </div>
    </header>
  )
}

<noscript
  ><style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      visibility: visible !important;
      grid-template-rows: 1fr !important;
    }
  </style></noscript
>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");
  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    };
    toggle.addEventListener("click", () =>
      setOpen(toggle.getAttribute("aria-expanded") !== "true"),
    );
    nav
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", () => setOpen(false)));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !nav.contains(event.target))
        setOpen(false);
    });
    matchMedia("(width >= 48rem)").addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });
  }

  const themeButtons = document.querySelectorAll<HTMLButtonElement>(
    "[data-theme-choice]",
  );
  const setTheme = (theme: "light" | "dark") => {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("kigudev-theme", theme);
    themeButtons.forEach((button) =>
      button.setAttribute(
        "aria-pressed",
        String(button.dataset.themeChoice === theme),
      ),
    );
  };
  themeButtons.forEach((button) =>
    button.addEventListener("click", () =>
      setTheme(button.dataset.themeChoice as "light" | "dark"),
    ),
  );
  setTheme(
    document.documentElement.dataset.theme === "light" ? "light" : "dark",
  );
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: fixed;
      z-index: 100;
      top: 0.75rem;
      inset-inline: 0;
      width: min(calc(100% - 2.5rem), 87.5rem);
      min-height: 3.75rem;
      margin-inline: auto;
      padding: 0.45rem 0.55rem 0.45rem 1.15rem;
      color: var(--text);
      background: color-mix(in srgb, var(--background) 92%, transparent);
      border: 0.0625rem solid var(--border);
      border-radius: var(--radius-round);
      backdrop-filter: blur(1.125rem);
    }
    .nav_inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1.5rem;
      min-height: 2.75rem;
    }
    .nav_logo {
      display: flex;
      align-items: center;
      width: auto;
      gap: 0.55rem;
      color: var(--text);
      font-size: 0.92rem;
      font-weight: 500;
      text-decoration: none;
    }
    .nav_logo img {
      width: 2.25rem;
      height: 2.25rem;
      object-fit: contain;
    }
    [data-theme="light"] .nav_logo img {
      filter: brightness(0) saturate(100%) invert(12%) sepia(22%)
        saturate(1307%) hue-rotate(169deg) brightness(90%);
    }
    .nav_menu {
      margin-left: auto;
    }
    .nav_links {
      display: flex;
      align-items: center;
      gap: 1.75rem;
      margin: 0;
      padding: 0;
      list-style: none;
    }
    .nav_links li {
      display: flex;
      align-items: center;
    }
    .nav_index {
      display: none;
      font-family: var(--label-family);
    }
    .nav_link {
      color: var(--text-2);
      font-family: var(--primary-family);
      font-size: 0.9rem;
      font-weight: 500;
      line-height: 1.2;
      letter-spacing: 0.01em;
      text-decoration: none;
      transition: color var(--hover-duration) var(--hover-ease);
    }
    .nav_link:hover {
      color: var(--text);
    }
    .nav_theme {
      display: flex;
      align-items: center;
      gap: 0.15rem;
      padding: 0.2rem;
      border: 0.0625rem solid var(--border);
      border-radius: var(--radius-round);
      background: color-mix(in srgb, var(--surface) 74%, transparent);
    }
    .nav_theme button {
      display: grid;
      place-items: center;
      width: 2rem;
      min-height: 2rem;
      color: var(--text-2);
      border-radius: 50%;
    }
    .nav_theme button[aria-pressed="true"] {
      color: var(--button-text);
      background: var(--button-background);
    }
    .nav_cta {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 2.75rem;
      padding-inline: 1.15rem;
      gap: 0.45rem;
      color: var(--button-text);
      background: var(--button-background);
      border: 0.0625rem solid var(--button-border);
      border-radius: var(--button-radius);
      font-family: var(--primary-family);
      font-size: 0.95rem;
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: -0.01em;
      text-decoration: none;
      transition:
        color 0.28s,
        background 0.28s;
    }
    .nav_cta:hover {
      color: var(--button-text-hover);
      background: var(--button-background-hover);
    }
    .nav_toggle,
    .nav_links .nav_mobile_contact {
      display: none;
    }
    @media (width < 48rem) {
      .nav_wrap {
        width: calc(100% - 1.5rem);
        padding-left: 1rem;
      }
      .nav_logo span {
        display: none;
      }
      .nav_cta {
        display: none;
      }
      .nav_logo {
        order: 1;
      }
      .nav_theme {
        order: 2;
        margin-left: auto;
      }
      .nav_toggle {
        order: 3;
        display: grid;
        place-items: center;
        width: 2.75rem;
        min-height: 2.75rem;
        margin-left: 0;
        border: 0.0625rem solid var(--border);
        border-radius: 50%;
      }
      .nav_toggle_close {
        display: none;
      }
      .nav_wrap.open .nav_toggle_open {
        display: none;
      }
      .nav_wrap.open .nav_toggle_close {
        display: block;
      }
      .nav_menu {
        position: absolute;
        top: calc(100% + 0.5rem);
        inset-inline: 0;
        display: grid;
        grid-template-rows: 0fr;
        visibility: hidden;
        overflow: hidden;
        background: var(--surface);
        border: 0.0625rem solid var(--border);
        border-radius: 1.5rem;
        transition:
          grid-template-rows 0.35s,
          visibility 0.35s;
      }
      .nav_wrap.open .nav_menu {
        grid-template-rows: 1fr;
        visibility: visible;
      }
      .nav_menu_inner {
        min-height: 0;
        overflow: hidden;
      }
      .nav_links {
        display: grid;
        gap: 0;
        padding: 1rem;
      }
      .nav_links li {
        min-height: 3.5rem;
        border-bottom: 0.0625rem solid var(--border);
      }
      .nav_links li:last-child {
        border-bottom: 0;
      }
      .nav_index {
        display: block;
        width: 2.5rem;
        color: var(--accent);
        font-size: 0.7rem;
      }
      .nav_link {
        flex: 1;
        padding-block: 1rem;
        color: var(--text);
        font-size: 1.35rem;
      }
      .nav_links .nav_mobile_contact {
        display: flex;
      }
    }
  }
</style>
