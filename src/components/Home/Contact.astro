---
import Heading from "@/components/Typography/Heading.astro";
import { SCHEDULE_URL } from "@/consts.ts";
import {
  leadOptions,
  leadLimits,
  communicationLanguages,
} from "@/utils/leadValidation.ts";
---

<section
  class="editorial-contact_wrap"
  id="contact"
  aria-labelledby="contact-title"
>
  <div class="editorial-contact_inner">
    <div class="editorial-contact_copy">
      <p class="editorial-kicker">Start a conversation</p><Heading
        tag="h2"
        variant="inherit"
        id="contact-title">Have a project in mind?</Heading
      ><p>
        None of the available hours fits you for a call? or there's no space in
        my schedule? You can also reach me by email at{" "}
        <a href="mailto:guillermo.obando@kiguidev.me"
          >guillermo.obando@kiguidev.me</a
        >.
      </p>
      <!-- <a
        class="editorial-button light"
        href={SCHEDULE_URL}
        target="_blank"
        rel="noopener noreferrer"
        >Schedule a call <i
          class="ph ph-arrow-up-right"
          aria-hidden="true"></i></a
      > -->
    </div>
    <form
      class="editorial-contact_form"
      id="contact-form"
      name="lead-qualification"
      method="POST"
      action="/.netlify/functions/submit-lead"
      data-lead-form
      novalidate
    >
      <input type="hidden" name="language" value="en" />
      <input
        type="text"
        name="website"
        class="editorial-contact_honeypot"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
      />
      <div class="editorial-step" data-step="1">
        <p class="editorial-step-label">Step 1 of 6</p><label for="service"
          >What service do you need?</label
        >
        <select id="service" name="service" required
          ><option value="">Choose a service</option>{
            leadOptions.service.map((option) => (
              <option value={option}>{option}</option>
            ))
          }</select
        >
      </div>
      <div class="editorial-step" data-step="2" hidden>
        <p class="editorial-step-label">Step 2 of 6</p><label for="description"
          >Tell me about your project.</label
        ><textarea
          id="description"
          name="description"
          class="editorial-textarea"
          rows="5"
          minlength="20"
          maxlength="3000"
          required
          placeholder="Business goals, current website, requirements, and desired outcomes"
        ></textarea><span class="editorial-hint"
          ><span class="character-count">0</span>/3,000 characters</span
        >
      </div>
      <div class="editorial-step" data-step="3" hidden>
        <p class="editorial-step-label">Step 3 of 6</p><label for="budget"
          >What's your estimated budget?</label
        ><select id="budget" name="budget" required
          ><option value="">Choose a range</option>{
            leadOptions.budget.map((option) => (
              <option value={option}>{option}</option>
            ))
          }</select
        >
      </div>
      <div class="editorial-step" data-step="4" hidden>
        <p class="editorial-step-label">Step 4 of 6</p><label for="timeline"
          >When would you like to get started?</label
        ><select id="timeline" name="timeline" required
          ><option value="">Choose a timeline</option>{
            leadOptions.timeline.map((option) => (
              <option value={option}>{option}</option>
            ))
          }</select
        >
      </div>
      <div class="editorial-step" data-step="5" hidden>
        <p class="editorial-step-label">Step 5 of 6</p><label for="decision"
          >Who will make the final decision?</label
        ><select id="decision" name="decision" required
          ><option value="">Choose one</option>{
            leadOptions.decision.map((option) => (
              <option value={option}>{option}</option>
            ))
          }</select
        >
      </div>
      <div class="editorial-step" data-step="6" hidden>
        <p class="editorial-step-label">Step 6 of 6</p>
        <div class="editorial-field wide">
          <label for="full-name">Full name</label><input
            id="full-name"
            name="name"
            autocomplete="name"
            maxlength={leadLimits.name}
            required
          />
        </div>
        <div class="editorial-field wide">
          <label for="email">Email</label><input
            id="email"
            name="email"
            type="email"
            maxlength={leadLimits.email}
            autocomplete="email"
            required
            aria-describedby="email-error"
          /><span id="email-error"></span>
        </div>
        <div class="editorial-field">
          <label for="company">Company (optional)</label><input
            id="company"
            name="company"
            autocomplete="organization"
            maxlength={leadLimits.company}
          />
        </div>
        <div class="editorial-field">
          <label for="website-url">Website (optional)</label><input
            id="website-url"
            name="websiteUrl"
            type="url"
            autocomplete="url"
            maxlength={leadLimits.websiteUrl}
          />
        </div>
        <div class="editorial-field wide">
          <label for="preferred-language"
            >Preferred communication language</label
          >
          <select
            id="preferred-language"
            name="preferredLanguage"
            required
            aria-describedby="preferred-language-help"
          >
            {
              communicationLanguages.map(({ value, label }) => (
                <option value={value} selected={value === "en"}>
                  {label}
                </option>
              ))
            }
          </select>
          <p class="editorial-hint" id="preferred-language-help">
            We'll use your preference when following up about your project.
          </p>
        </div>
        <div class="editorial-consent wide">
          <label for="privacy-consent"
            ><input
              id="privacy-consent"
              name="privacyConsent"
              type="checkbox"
              value="accepted"
              required
              aria-describedby="privacy-consent-error"
            /><span
              >I have read the <a
                href="/privacy-policy"
                target="_blank"
                rel="noopener noreferrer">Privacy Policy</a
              > and consent to the processing and international transfer of my information
              so Kiguidev can respond to my inquiry.</span
            ></label
          ><span id="privacy-consent-error"></span>
        </div>
      </div>
      <div class="editorial-step-actions wide">
        <button class="editorial-step-back" type="button" data-back hidden
          >Back</button
        ><button class="editorial-submit" type="button" data-next
          >Continue</button
        ><button class="editorial-submit" type="submit" data-submit hidden
          >Send inquiry</button
        >
      </div>
      <p class="editorial-error wide" data-error role="alert"></p>
      <p class="editorial-status wide" role="status" aria-live="polite"></p>
      <div class="editorial-success wide" data-success hidden>
        <strong tabindex="-1"
          >Your inquiry has been submitted successfully!</strong
        ><p>We'll review your project details and get back to you soon.</p><p
          class="editorial-hint"
          data-confirmation-reminder
          hidden
        >
          Please check your inbox and spam folder for our confirmation email.
        </p><a
          class="editorial-button light"
          data-calendly
          href={SCHEDULE_URL}
          target="_blank"
          rel="noopener noreferrer"
          hidden
          >Schedule a Discovery Call <i
            class="ph ph-arrow-up-right"
            aria-hidden="true"></i></a
        >
      </div>
    </form>
  </div>
</section>

<script>
  import { validateLead } from "@/utils/leadValidation.ts";
  import { leadErrorMessage } from "@/utils/leadErrors.ts";
  import { onHomeMotion, reveal } from "@/utils/homeMotion.ts";
  onHomeMotion(() => reveal(".editorial-contact_copy"));
  let formController: AbortController | undefined;
  const initializeForm = () => {
    formController?.abort();
    formController = new AbortController();
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    if (!form) return;
    const status = form.querySelector<HTMLElement>(".editorial-status");
    const error = form.querySelector<HTMLElement>("[data-error]");
    const steps = [...form.querySelectorAll<HTMLElement>("[data-step]")];
    const next = form.querySelector<HTMLButtonElement>("[data-next]");
    const back = form.querySelector<HTMLButtonElement>("[data-back]");
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    const success = form.querySelector<HTMLElement>("[data-success]");
    const confirmationReminder = form.querySelector<HTMLElement>(
      "[data-confirmation-reminder]",
    );
    const calendly = form.querySelector<HTMLAnchorElement>("[data-calendly]");
    let current = 0;
    const analytics = (event: string) =>
      window.dispatchEvent(
        new CustomEvent("kiguidev:analytics", { detail: { event } }),
      );
    const renderStep = (focus = false) => {
      steps.forEach((step, index) => {
        step.hidden = index !== current;
      });
      if (back) back.hidden = current === 0;
      if (next) next.hidden = current === steps.length - 1;
      if (submit) submit.hidden = current !== steps.length - 1;
      if (focus)
        steps[current]
          ?.querySelector<HTMLElement>("input, select, textarea")
          ?.focus();
    };
    const validateStep = () => {
      const fields = [
        ...(steps[current]?.querySelectorAll<
          HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement
        >("input, select, textarea") ?? []),
      ];
      const invalid = fields.find((field) => !field.checkValidity());
      if (invalid) {
        invalid.focus();
        invalid.reportValidity();
        analytics("lead_form_validation_failed");
        return false;
      }
      return true;
    };
    if (success && !success.hidden) return;
    renderStep();
    const textArea = form.querySelector<HTMLTextAreaElement>("#description");
    const counter = form.querySelector<HTMLElement>(".character-count");
    const updateCounter = () => {
      if (counter && textArea)
        counter.textContent = textArea.value.length.toLocaleString("en-US");
    };
    textArea?.addEventListener("input", updateCounter, {
      signal: formController.signal,
    });
    updateCounter();
    analytics("lead_form_opened");
    next?.addEventListener(
      "click",
      () => {
        if (!validateStep()) return;
        current++;
        analytics("lead_form_step_completed");
        renderStep(true);
      },
      { signal: formController.signal },
    );
    back?.addEventListener(
      "click",
      () => {
        current--;
        renderStep(true);
      },
      { signal: formController.signal },
    );
    form.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();
        if (form.dataset.submitting === "true") return;
        if (!validateStep()) return;
        const data = Object.fromEntries(new FormData(form).entries());
        const { fields } = validateLead(data);
        if (fields.length) {
          const field = form.elements.namedItem(fields[0]);
          const index =
            field instanceof HTMLElement
              ? steps.findIndex((step) => step.contains(field))
              : -1;
          if (index >= 0) {
            current = index;
            renderStep();
          }
          if (field instanceof HTMLElement) field.focus();
          if (error) error.textContent = leadErrorMessage(400);
          analytics("lead_form_validation_failed");
          return;
        }
        form.dataset.submitting = "true";
        const button = form.querySelector<HTMLButtonElement>("[data-submit]");
        if (button) button.disabled = true;
        if (next) next.disabled = true;
        if (back) back.disabled = true;
        if (status) status.textContent = "Sending your inquiry...";
        if (error) error.textContent = "";
        let failureReason = "The form service could not be reached.";
        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok || result.ok !== true) {
            failureReason = leadErrorMessage(
              response.ok ? 500 : response.status,
              result.code,
            );
            if (import.meta.env.DEV)
              console.info("Lead submission failed", {
                status: response.status,
                code: result.code,
                requestId: response.headers.get("x-request-id"),
              });
            throw new Error("Submission failed");
          }
          analytics("lead_form_submitted");
          form
            .querySelectorAll<HTMLElement>(
              "[data-step], .editorial-step-actions, .editorial-error, .editorial-status",
            )
            .forEach((el) => {
              el.hidden = true;
            });
          if (confirmationReminder)
            confirmationReminder.hidden = result.confirmationSent !== true;
          if (success) success.hidden = false;
          if (calendly && result.priority === "high") calendly.hidden = false;
          success?.querySelector("strong")?.focus();
        } catch {
          analytics("lead_form_submission_failed");
          if (status) status.textContent = "";
          if (error)
            error.textContent = `${failureReason} Please try again or email guillermo.obando@kiguidev.me.`;
        } finally {
          delete form.dataset.submitting;
          if (button) button.disabled = false;
          if (next) next.disabled = false;
          if (back) back.disabled = false;
        }
      },
      { signal: formController.signal },
    );
    calendly?.addEventListener(
      "click",
      () => analytics("lead_calendly_clicked"),
      { signal: formController.signal },
    );
  };
  initializeForm();
  document.addEventListener("astro:page-load", initializeForm);
  document.addEventListener("astro:before-swap", () => formController?.abort());
</script>

<style is:global>
  @layer components {
    .editorial-textarea {
      resize: none;
    }
    .editorial-textarea::placeholder {
      color: #ffffff;
    }
    .editorial-contact_wrap {
      padding-block: clamp(6rem, 12vw, 10rem);
      color: #eff8f7;
      background: #187f94;
    }
    .editorial-contact_inner {
      display: grid;
      gap: 5rem;
    }
    .editorial-contact_copy > p:not(:first-child) {
      max-width: 31rem;
      font-size: 1.1rem;
      line-height: 1.5;
    }
    .editorial-contact_form {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.25rem;
    }
    .editorial-contact_honeypot,
    .editorial-contact_form [hidden] {
      display: none !important;
    }
    .editorial-step {
      display: grid;
      grid-column: 1/-1;
      gap: 0.65rem;
    }
    .editorial-step > label {
      font: 600 0.7rem/1.2 var(--label-family);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .editorial-step select,
    .editorial-step textarea,
    .editorial-step input {
      width: 100%;
      border: 0;
      border-bottom: 0.0625rem solid rgb(239 248 247/48%);
      border-radius: 0;
      padding: 0.75rem 0;
      color: #eff8f7;
      background: transparent;
      font: inherit;
    }
    .editorial-step select option {
      color: #071722;
    }
    .editorial-step-label,
    .editorial-hint {
      color: #a9c3c8;
      font-size: 0.75rem;
    }
    .editorial-step-actions {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
    }
    .editorial-step-back {
      border: 0;
      color: #eff8f7;
      background: transparent;
      font: inherit;
      cursor: pointer;
    }
    .editorial-error {
      color: #ffe2de;
    }
    .editorial-success {
      display: grid;
      gap: 0.5rem;
    }
    .editorial-success strong:focus {
      outline: none;
    }
    .editorial-contact_honeypot {
      position: absolute;
      left: -100vw;
      width: 1px;
      height: 1px;
      overflow: hidden;
    }
    .editorial-field {
      display: grid;
      gap: 0.45rem;
    }
    .editorial-field.wide,
    .editorial-consent.wide,
    .editorial-step-actions.wide,
    .editorial-error.wide,
    .editorial-success.wide,
    .editorial-status.wide {
      grid-column: 1/-1;
    }
    .editorial-field label {
      font: 600 0.7rem/1.2 var(--label-family);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }
    .editorial-field input,
    .editorial-field textarea {
      width: 100%;
      border: 0;
      border-bottom: 0.0625rem solid rgb(239 248 247/48%);
      border-radius: 0;
      padding: 0.75rem 0;
      color: #eff8f7;
      background: transparent;
      font: inherit;
    }
    .editorial-field textarea {
      resize: vertical;
    }
    .editorial-field > span,
    .editorial-consent > span {
      min-height: 1em;
      color: #ffe2de;
      font-size: 0.72rem;
    }
    .editorial-consent label {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: start;
      gap: 0.75rem;
      font-size: 0.78rem;
      line-height: 1.45;
    }
    .editorial-consent input {
      margin-top: 0.15rem;
      accent-color: #071722;
    }
    .editorial-consent a {
      color: inherit;
    }
    .editorial-status {
      min-height: 1.5em;
    }
    @media (width >= 48rem) {
      .editorial-contact_inner {
        grid-template-columns: 1fr 1fr;
      }
    }
    @media (width < 48rem) {
      .editorial-contact_form {
        grid-template-columns: 1fr;
      }
      .editorial-field {
        grid-column: 1/-1;
      }
    }
  }
</style>
