---
import { Image } from "astro:assets";
import Heading from "@/components/Typography/Heading.astro";
import JossPic from "@/assets/jossprof.webp";
import CarmenPic from "@/assets/Carmen-profile.webp";

const testimonials: {
  quote: string;
  name: string;
  role: string;
  image?: ImageMetadata;
}[] = [
  {
    // owner: replace [Name] with the Meguis owner's name once approved
    quote:
      "Guillermo handled everything: design, development, and SEO. After the site went live and was set up in Google Search Console, I started getting more clients.",
    name: "Carmen Cerna",
    role: "owner — Meguis Import & Export",
    image: CarmenPic,
  },
  {
    // owner: paste Joss Segura's approved quote before publishing
    quote: "[PENDING APPROVAL — paste Joss Segura's approved quote]",
    name: "Joss Segura",
    role: "DeCorazonJoss",
    image: JossPic,
  },
  {
    quote:
      "This project helped us launch faster with a beautiful digital experience that feels completely ours.",
    name: "Kattia Altamirano",
    role: "Founder & CEO, Kalta Agency",
  },
];
---

<section
  class="editorial-testimonials_wrap"
  aria-labelledby="testimonials-title"
>
  <div class="editorial-testimonials_inner">
    <header class="editorial-section_header editorial-testimonials_header">
      <p class="editorial-kicker">Testimonials</p><Heading
        tag="h2"
        variant="inherit"
        id="testimonials-title">Loved by builders <em>everywhere.</em></Heading
      ><p class="editorial-serif">
        Don&rsquo;t take my word for it, here&rsquo;s what founders I&rsquo;ve
        worked with have to say.
      </p>
    </header>
    <div class="editorial-testimonials_grid">
      {
        testimonials.map((testimonial) => (
          <figure class="editorial-testimonial_card">
            <blockquote>
              <i class="ph ph-quotes" aria-hidden="true" />
              <p>{testimonial.quote}</p>
            </blockquote>
            <figcaption>
              {testimonial.image && (
                <Image
                  src={testimonial.image}
                  alt={`${testimonial.name}'s profile picture`}
                  width={48}
                  height={48}
                  loading="lazy"
                />
              )}
              <span>
                <cite>{testimonial.name}</cite>
                <span>{testimonial.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { onHomeMotion, reveal, staggerCards } from "@/utils/homeMotion.ts";
  onHomeMotion(() => {
    reveal(".editorial-testimonials_header");
    staggerCards(".editorial-testimonial_card", ".editorial-testimonials_grid");
  });
</script>

<style is:global>
  @layer components {
    .editorial-testimonials_wrap {
      padding-block: 0 clamp(7rem, 13vw, 12rem);
    }
    .editorial-testimonials_inner {
      display: grid;
      gap: clamp(3rem, 6vw, 5rem);
    }
    .editorial-testimonials_header {
      justify-items: center;
      text-align: center;
    }
    .editorial-testimonials_header.editorial-section_header h2 {
      max-width: none;
    }
    .editorial-testimonials_header em {
      display: block;
      color: var(--accent-page);
      font-style: normal;
    }
    .editorial-testimonials_grid {
      display: grid;
      gap: 1rem;
    }
    .editorial-testimonial_card {
      display: flex;
      min-height: 17rem;
      margin: 0;
      padding: clamp(1.5rem, 3vw, 2.5rem);
      flex-direction: column;
      justify-content: space-between;
      gap: 2.5rem;
      border-radius: 1.5rem;
      background: color-mix(in srgb, var(--paper) 35%, white);
      box-shadow: 0 1.5rem 3.5rem rgb(5 31 42/10%);
    }
    [data-theme="dark"] .editorial-testimonial_card {
      background: color-mix(in srgb, var(--paper) 92%, white);
    }
    .editorial-testimonial_card:last-child {
      color: #edf4f3;
      background: var(--navy);
    }
    .editorial-testimonial_card blockquote {
      display: grid;
      margin: 0;
      gap: 1rem;
    }
    .editorial-testimonial_card i {
      color: var(--accent-page);
      font-size: 1.5rem;
      line-height: 1;
    }
    .editorial-testimonial_card blockquote p {
      color: color-mix(in srgb, currentColor 78%, transparent);
      font-size: 1rem;
      line-height: 1.6;
    }
    .editorial-testimonial_card:first-child blockquote p {
      font:
        500 clamp(1.25rem, 2vw, 1.6rem)/1.4 "Fraunces",
        Georgia,
        serif;
    }
    .editorial-testimonial_card figcaption {
      display: flex;
      gap: 0.85rem;
      align-items: center;
    }
    .editorial-testimonial_card figcaption img {
      width: 2.75rem;
      height: 2.75rem;
      flex: none;
      border-radius: 50%;
      object-fit: cover;
    }
    .editorial-testimonial_card figcaption > span {
      display: grid;
      gap: 0.2rem;
    }
    .editorial-testimonial_card cite {
      font-size: 0.9rem;
      font-style: normal;
      font-weight: 600;
    }
    .editorial-testimonial_card figcaption > span > span {
      color: color-mix(in srgb, currentColor 66%, transparent);
      font-size: 0.75rem;
    }
    @media (width >= 48rem) {
      .editorial-testimonials_grid {
        grid-template-columns: 1.15fr 1fr;
      }
      .editorial-testimonial_card:first-child {
        grid-row: span 2;
      }
    }
  }
</style>
