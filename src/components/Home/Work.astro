---
import { Image } from "astro:assets";
import Heading from "@/components/Typography/Heading.astro";
import { projects } from "@/data/projects.ts";
---

<section class="editorial-work_wrap" id="work" aria-labelledby="work-title">
  <div class="editorial-work_inner">
    <header class="editorial-section_header">
      <p class="editorial-kicker">Selected projects</p><Heading
        tag="h2"
        variant="inherit"
        id="work-title">Work that earns attention.</Heading
      >
    </header>
    <div class="editorial-work_word" aria-hidden="true">WORK</div>
    <div class="editorial-projects_list">
      {
        projects.map((project, index) => (
          <a
            class="editorial-project_card"
            href={`/projects/${project.slug}`}
            style={`--card-index:${index}`}
          >
            <div class="editorial-project_media">
              <Image
                src={project.image}
                alt={project.imageAlt}
                widths={[480, 720, 960]}
                sizes="(max-width: 48rem) 86vw, 25vw"
                loading={index < 3 ? "eager" : "lazy"}
              />
            </div>
            <div class="editorial-project_copy">
              <>
                <div>
                  <>
                    <p>{project.category}</p>
                    <h3>{project.title}</h3>
                  </>
                </div>
                <i class="ph ph-arrow-up-right" aria-hidden="true" />
                <span>{project.role}</span>
              </>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { onHomeMotion, reveal, staggerCards } from "@/utils/homeMotion.ts";
  onHomeMotion(() => {
    reveal(".editorial-work_wrap .editorial-section_header");
    staggerCards(".editorial-project_card", ".editorial-projects_list");
  });
</script>

<style is:global>
  @layer components {
    .editorial-work_wrap {
      position: relative;
      overflow: hidden;
      padding-block: clamp(6rem, 12vw, 11rem);
      color: #06131d;
      background: #88d6de;
    }
    [data-theme="dark"] .editorial-work_wrap {
      color: #eaf7f6;
      background: #105669;
    }
    .editorial-work_word {
      margin: clamp(4rem, 8vw, 7rem) -4vw -3vw;
      font:
        800 clamp(12rem, 37vw, 35rem)/0.54 "Barlow Condensed",
        sans-serif;
      letter-spacing: -0.07em;
      opacity: 0.14;
      white-space: nowrap;
    }
    .editorial-projects_list {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      align-items: center;
      margin-top: -6vw;
      padding-inline: 2vw;
    }
    .editorial-project_card {
      display: grid;
      overflow: hidden;
      border-radius: 1rem;
      color: #071722;
      background: #f2f3eb;
      box-shadow: 0 1.5rem 3.5rem rgb(5 31 42/18%);
      text-decoration: none;
      transform: rotate(calc((var(--card-index) - 2) * 2deg));
      transition:
        transform 350ms cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 350ms;
    }
    .editorial-project_card + .editorial-project_card {
      margin-left: -18%;
    }
    .editorial-project_card:nth-child(2n) {
      transform: translateY(2rem) rotate(3deg);
    }
    .editorial-project_card:hover,
    .editorial-project_card:focus-visible {
      position: relative;
      z-index: 4;
      transform: translateY(-1.5rem) rotate(0);
      box-shadow: 0 2.4rem 5rem rgb(5 31 42/28%);
    }
    .editorial-project_media {
      aspect-ratio: 4/5;
      overflow: hidden;
    }
    .editorial-project_media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 500ms;
    }
    .editorial-project_card:hover .editorial-project_media img {
      transform: scale(1.04);
    }
    .editorial-project_copy {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 0.75rem;
      padding: 1rem;
    }
    .editorial-project_copy p,
    .editorial-project_copy > span {
      font-size: 0.66rem;
      line-height: 1.35;
    }
    .editorial-project_copy h3 {
      margin-top: 0.3rem;
      font:
        500 clamp(1.05rem, 1.7vw, 1.45rem)/1.05 "Fraunces",
        Georgia,
        serif;
    }
    .editorial-project_copy > span {
      grid-column: 1/-1;
      color: rgb(7 23 34/66%);
    }
    @media (width < 48rem) {
      .editorial-projects_list {
        display: flex;
        margin-top: -1rem;
        padding: 2rem 1rem 3rem;
        gap: 1rem;
        overflow-x: auto;
        scroll-snap-type: x mandatory;
      }
      .editorial-project_card,
      .editorial-project_card:nth-child(2n) {
        flex: 0 0 min(82vw, 22rem);
        scroll-snap-align: center;
        transform: none;
      }
      .editorial-work_word {
        margin-bottom: 0;
      }
    }
  }
</style>
