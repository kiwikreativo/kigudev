---
import { Image } from "astro:assets";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import { projects } from "@/data/projects.ts";
---

<article class="projects-index_wrap">
  <header class="projects-index_hero">
    <div class="projects-index_container">
      <p class="projects-index_eyebrow">Selected work / 05</p>
      <Heading tag="h1" variant="inherit" class="projects-index_title">Web design and development projects</Heading>
      <Paragraph class="projects-index_lede">Selected business websites, product experiences, and interface projects built around clear goals and usable outcomes.</Paragraph>
    </div>
  </header>
  <section class="projects-index_list" aria-label="Project case studies">
    <div class="projects-index_container">
      {projects.map((project) => (
        <a class="projects-index_item" href={`/projects/${project.slug}/`}>
          <div class="projects-index_media"><Image src={project.image} alt={project.imageAlt} widths={[480, 720, 960]} sizes="(max-width: 48rem) 100vw, 40vw" loading="lazy" /></div>
          <div class="projects-index_copy"><span>{project.number} / {project.category}</span><h2>{project.title}</h2><p>{project.shortDescription}</p></div>
        </a>
      ))}
    </div>
  </section>
</article>

<style>
  @layer components {
    .projects-index_wrap { color: var(--text); background: var(--background); }
    .projects-index_container { width: min(calc(100% - 2.5rem), 80rem); margin-inline: auto; }
    .projects-index_hero { padding-block: clamp(9rem, 16vw, 14rem) clamp(5rem, 9vw, 8rem); }
    .projects-index_eyebrow { margin: 0 0 1.5rem; color: var(--accent); font-family: var(--label-family); font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; }
    .projects-index_title { max-width: 13ch; margin: 0; font-family: var(--display-family); font-size: clamp(2.75rem, 9vw, 8rem); font-weight: 500; line-height: 0.88; letter-spacing: -0.055em; text-wrap: balance; }
    .projects-index_lede { max-width: 42rem; margin: 2.5rem 0 0 auto; color: var(--text-secondary); font-size: clamp(1rem, 2vw, 1.25rem); line-height: 1.65; }
    .projects-index_list { padding-bottom: clamp(6rem, 12vw, 11rem); }
    .projects-index_list .projects-index_container { display: grid; gap: 1.5rem; }
    .projects-index_item { display: grid; overflow: hidden; color: #fff; border-radius: 1.25rem; background: #07141d; text-decoration: none; }
    .projects-index_media { min-height: 18rem; overflow: hidden; }
    .projects-index_media :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 350ms ease; }
    .projects-index_item:hover .projects-index_media :global(img) { transform: scale(1.025); }
    .projects-index_copy { display: grid; padding: 1.75rem; align-content: center; }
    .projects-index_copy span { color: #61a5c2; font-family: var(--label-family); font-size: 0.7rem; letter-spacing: 0.1em; text-transform: uppercase; }
    .projects-index_copy h2 { margin: 1rem 0; font-family: var(--display-family); font-size: clamp(2rem, 5vw, 4rem); font-weight: 500; line-height: 0.95; letter-spacing: -0.04em; }
    .projects-index_copy p { max-width: 34rem; margin: 0; color: rgb(255 255 255 / 72%); line-height: 1.6; }
    @media (width >= 48rem) { .projects-index_item { grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); min-height: 30rem; } .projects-index_item:nth-child(even) .projects-index_media { order: 2; } }
  }
</style>
