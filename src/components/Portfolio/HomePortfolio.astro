---
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Accordion from "@/components/Interactive/Accordion.astro";
import AccordionItem from "@/components/Interactive/AccordionItem.astro";
import Slider from "@/components/Interactive/Slider.astro";
import Marquee from "@/components/Interactive/Marquee.astro";
import comic from "@/assets/logo/comic.png";
import projectOne from "@/assets/logo/1.webp";
import projectTwo from "@/assets/logo/2.webp";
import projectThree from "@/assets/logo/3.webp";
import projectFour from "@/assets/logo/4.webp";

const services = [
  {
    number: "01",
    title: "UI/UX Design",
    copy: "Clear and thoughtful interfaces designed around real users and business goals.",
    detail: "Research · user flows · design systems",
    image: projectOne,
  },
  {
    number: "02",
    title: "Web Development",
    copy: "Responsive, polished websites built to turn approved designs into reliable digital experiences.",
    detail: "Business sites · landing pages · e-commerce",
    image: projectTwo,
  },
  {
    number: "03",
    title: "Mobile Enhancement",
    copy: "Improving layouts and interactions so websites remain clear, usable, and comfortable on smaller screens.",
    detail: "Responsive redesign · usability · accessibility",
    image: projectThree,
  },
  {
    number: "04",
    title: "SEO",
    copy: "Building a stronger technical and content foundation so search engines and users can better understand the site.",
    detail: "Structure · performance · discoverability",
    image: projectFour,
  },
];

const projects = [
  {
    image: projectOne,
    title: "Independent identity",
    category: "Brand system & portfolio",
    copy: "A distinct visual language built to make a personal practice feel clear, recognizable, and ready to grow.",
    role: "Design direction",
    focus: "UI/UX + web development",
    timeline: "4 weeks",
  },
  {
    image: projectTwo,
    title: "Product clarity",
    category: "Interface design",
    copy: "A focused product experience that reduces friction, improves hierarchy, and makes the next action obvious.",
    role: "UX & front-end",
    focus: "Clear customer journeys",
    timeline: "6 weeks",
  },
  {
    image: projectThree,
    title: "Responsive by nature",
    category: "Mobile enhancement",
    copy: "A considered mobile rebuild that preserves personality while improving rhythm, reachability, and speed.",
    role: "Responsive design",
    focus: "Responsive redesign",
    timeline: "3 weeks",
  },
];
---

<div class="portfolio_wrap">
  <section class="portfolio-hero_wrap" aria-labelledby="hero-title">
    <div class="portfolio-hero_ambient" aria-hidden="true"></div>
    <div class="portfolio-hero_circles" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <Heading
      tag="h1"
      variant="inherit"
      id="hero-title"
      class="portfolio-hero_title">KIGUDEV</Heading
    >
    <div class="portfolio-hero_stage">
      <div class="portfolio-hero_portrait">
        <Image
          src={comic}
          alt="Illustrated portrait of Kigudev"
          widths={[320, 480, 640]}
          sizes="(max-width: 48rem) 95vw, (max-width: 64rem) 37rem, 43rem"
          loading="eager"
        />
      </div>
    </div>
    <div class="portfolio-hero_left">
      <p class="portfolio-hero_role">Software engineer + UI/UX</p>
      <Paragraph class="portfolio-hero_text"
        >I design and build thoughtful digital experiences with a focus on
        usability, performance, and clarity.</Paragraph
      >
    </div>
    <div class="portfolio-hero_right">
      <Paragraph class="portfolio-hero_text"
        >Merging design thinking with software engineering to create digital
        experiences that are intuitive, efficient, and thoughtfully built.</Paragraph
      >
      <Button element="link" href="#contact" class="portfolio-hero_cta"
        >Start a project <span
          class="portfolio-hero_cta-mark"
          aria-hidden="true"><i class="ph ph-arrow-up-right"></i></span
        ></Button
      >
    </div>
  </section>

  <section class="portfolio-tech_wrap" aria-label="Services">
    <Marquee label="Services" class="portfolio-tech_marquee">
      {
        [
          "UI/UX Design",
          "Web Design",
          "Web Development",
          "Responsive Design",
          "Mobile Enhancement",
          "SEO",
          "Landing Pages",
          "E-commerce",
          "Design Systems",
          "Website Redesign",
        ].map((item) => <span class="portfolio-tech_item">{item}</span>)
      }
    </Marquee>
  </section>

  <section class="portfolio-work_wrap" id="work" aria-labelledby="work-title">
    <div class="portfolio-container portfolio-work_inner">
      <div class="portfolio-heading_wrap centered">
        <p class="portfolio-kicker">Selected projects</p><Heading
          tag="h2"
          variant="inherit"
          id="work-title"
          class="portfolio-section_title">Work made to be useful</Heading
        >
      </div>
      <Slider
        variant="contained"
        xsmall={1}
        class="portfolio-work_slider"
        label="Selected Kigudev projects"
      >
        {
          projects.map((project) => (
            <article class="portfolio-project_wrap">
              <div class="portfolio-project_media">
                <Image
                  src={project.image}
                  alt={`${project.title} project artwork`}
                  widths={[480, 720, 960]}
                  sizes="(max-width: 48rem) 100vw, 45vw"
                  loading="lazy"
                />
              </div>
              <div class="portfolio-project_content">
                <p class="portfolio-project_category">{project.category}</p>
                <Heading
                  tag="h3"
                  variant="inherit"
                  class="portfolio-project_title"
                >
                  {project.title}
                </Heading>
                <Paragraph class="portfolio-project_text">
                  {project.copy}
                </Paragraph>
                <dl class="portfolio-project_meta">
                  <>
                    <div>
                      <>
                        <dt>Role</dt>
                        <dd>{project.role}</dd>
                      </>
                    </div>
                    <div>
                      <>
                        <dt>Focus</dt>
                        <dd>{project.focus}</dd>
                      </>
                    </div>
                    <div>
                      <>
                        <dt>Timeline</dt>
                        <dd>{project.timeline}</dd>
                      </>
                    </div>
                  </>
                </dl>
                <Button element="link" href="#contact" emphasis="secondary">
                  Discuss a similar project{" "}
                  <i class="ph ph-arrow-up-right" aria-hidden="true" />
                </Button>
              </div>
            </article>
          ))
        }
      </Slider>
    </div>
  </section>

  <section
    class="portfolio-services_wrap"
    id="services"
    aria-labelledby="services-title"
  >
    <div class="portfolio-services_inner">
      <Heading
        tag="h2"
        variant="inherit"
        id="services-title"
        class="portfolio-services_title">Services</Heading
      >
      <div class="portfolio-services_list">
        {
          services.map(({ number, title, copy, detail, image }) => (
            <article class="portfolio-service_item">
              <span class="portfolio-service_number">{number}</span>
              <Heading
                tag="h3"
                variant="inherit"
                class="portfolio-service_title"
              >
                {title}
              </Heading>
              <p class="portfolio-service_meta">{detail}</p>
              <Paragraph class="portfolio-service_text">{copy}</Paragraph>
              <div class="portfolio-service_media">
                <Image
                  src={image}
                  alt={`${title} project preview`}
                  widths={[240, 360, 480]}
                  sizes="(max-width: 48rem) 100vw, 18vw"
                  loading="lazy"
                />
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="portfolio-about_wrap"
    id="about"
    aria-labelledby="about-title"
  >
    <div class="portfolio-container portfolio-about_inner">
      <div class="portfolio-about_heading">
        <p class="portfolio-kicker">My approach</p><Heading
          tag="h2"
          variant="inherit"
          id="about-title"
          class="portfolio-section_title"
          >Design thoughtfully.<br />Build deliberately.<br />Improve
          continuously.</Heading
        >
      </div>
      <div class="portfolio-about_copy" data-reveal-copy>
        <p>
          Good digital work begins with understanding what people need, then
          removing everything that gets in their way.
        </p><p>
          I combine product thinking, interface design, and front-end
          development so ideas survive the journey from a Figma file to a
          responsive, accessible, high-performing product.
        </p>
      </div>
    </div>
  </section>

  <section class="portfolio-faq_wrap" id="faq" aria-labelledby="faq-title">
    <div class="portfolio-container portfolio-faq_inner">
      <div class="portfolio-heading_wrap centered">
        <p class="portfolio-kicker">The practical details</p><Heading
          tag="h2"
          variant="inherit"
          id="faq-title"
          class="portfolio-section_title">Common questions</Heading
        >
      </div>
      <Accordion single openFirst class="portfolio-faq_list">
        <AccordionItem
          heading="What type of projects do you work on?"
          headingTag="h3"
          ><p>
            I work on business websites, landing pages, portfolios, e-commerce
            experiences, website redesigns, and UI/UX improvements. I can help
            with both new projects and existing websites that need a clearer,
            more modern, or more responsive experience.
          </p></AccordionItem
        >
        <AccordionItem
          heading="Can you handle both the design and development?"
          headingTag="h3"
          ><p>
            Yes. I can take a project from initial ideas and interface design
            through front-end implementation, responsive behavior, interaction
            details, and final delivery. This keeps the visual direction and the
            finished website consistent throughout the project.
          </p></AccordionItem
        >
        <AccordionItem
          heading="How long does a website usually take?"
          headingTag="h3"
          ><p>
            Timelines depend on the size and complexity of the project. A
            focused landing page can often be completed faster, while a larger
            website with multiple pages, custom interactions, or content
            management will require more time. After reviewing the requirements,
            I provide a clear estimated timeline before development begins.
          </p></AccordionItem
        >
        <AccordionItem
          heading="Can you redesign or improve an existing website?"
          headingTag="h3"
          ><p>
            Yes. I can improve an existing website’s visual hierarchy,
            usability, responsive behavior, mobile experience, performance, and
            overall presentation without necessarily rebuilding everything from
            scratch.
          </p></AccordionItem
        >
        <AccordionItem
          heading="Will the website work well on mobile devices?"
          headingTag="h3"
          ><p>
            Yes. Responsive behavior is considered from the beginning. The final
            website is tested across mobile, tablet, and desktop layouts so the
            experience remains clear and usable at different screen sizes.
          </p></AccordionItem
        >
        <AccordionItem
          heading="Do you provide SEO optimization?"
          headingTag="h3"
          ><p>
            Yes. I can implement essential technical and on-page SEO foundations
            such as semantic structure, metadata, page titles, descriptions,
            performance improvements, responsive behavior, accessibility
            considerations, and search-friendly page organization.
          </p></AccordionItem
        >
        <AccordionItem heading="How do we start a project?" headingTag="h3"
          ><p>
            Start by sending a message through the contact form or scheduling a
            call. We can discuss your goals, the type of website you need, your
            current materials, expected features, timeline, and any references
            you already have.
          </p></AccordionItem
        >
      </Accordion>
    </div>
  </section>

  <section
    class="portfolio-contact_wrap"
    id="contact"
    aria-labelledby="contact-title"
  >
    <div class="portfolio-contact_inner">
      <div class="portfolio-contact_copy">
        <p class="portfolio-kicker">Start a conversation</p>
        <Heading
          tag="h2"
          variant="inherit"
          id="contact-title"
          class="portfolio-contact_title"
          >Tell me about your next project.</Heading
        >
        <p class="portfolio-contact_text">
          Share what you are building, improving, or trying to clarify. I will
          review the details and get back to you with a practical next step.
        </p>
      </div>
      <form class="portfolio-contact_form" id="contact-form" novalidate>
        <div class="portfolio-contact_field">
          <label for="first-name">First Name</label><input
            id="first-name"
            name="firstName"
            autocomplete="given-name"
            required
            aria-describedby="first-name-error"
          /><span class="portfolio-contact_error" id="first-name-error"></span>
        </div>
        <div class="portfolio-contact_field">
          <label for="last-name">Last Name</label><input
            id="last-name"
            name="lastName"
            autocomplete="family-name"
            required
            aria-describedby="last-name-error"
          /><span class="portfolio-contact_error" id="last-name-error"></span>
        </div>
        <div class="portfolio-contact_field wide">
          <label for="email">Email</label><input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            aria-describedby="email-error"
          /><span class="portfolio-contact_error" id="email-error"></span>
        </div>
        <div class="portfolio-contact_field wide">
          <label for="subject">Subject</label><input
            id="subject"
            name="subject"
            required
            aria-describedby="subject-error"
          /><span class="portfolio-contact_error" id="subject-error"></span>
        </div>
        <div class="portfolio-contact_field wide">
          <label for="message">Message</label><textarea
            id="message"
            name="message"
            rows="6"
            required
            aria-describedby="message-error"></textarea><span
            class="portfolio-contact_error"
            id="message-error"></span>
        </div>
        <div class="portfolio-contact_submit wide">
          <button type="submit"
            >Send Message <i class="ph ph-paper-plane-tilt" aria-hidden="true"
            ></i></button
          >
        </div>
      </form>
    </div>
  </section>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
      gsap.fromTo(
        [
          ".portfolio-hero_title",
          ".portfolio-hero_left",
          ".portfolio-hero_right",
        ],
        { y: 14, opacity: 0 },
        {
          y: 0,
          opacity: 1,
          duration: 0.7,
          stagger: 0.08,
          ease: "power2.out",
        },
      );
      gsap.fromTo(
        ".portfolio-hero_portrait",
        { y: 20, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.8, ease: "power2.out" },
      );
      gsap.utils
        .toArray<HTMLElement>(
          ".portfolio-project_media, .portfolio-service_media",
        )
        .forEach((media) =>
          gsap.fromTo(
            media,
            { scale: 0.88, opacity: 0.45 },
            {
              scale: 1,
              opacity: 1,
              ease: "none",
              scrollTrigger: {
                trigger: media,
                start: "top 88%",
                end: "center 52%",
                scrub: 0.7,
              },
            },
          ),
        );
      const copy = document.querySelector<HTMLElement>("[data-reveal-copy]");
      if (copy) {
        const words = copy.innerText.trim().split(/\s+/);
        copy.innerHTML = words.map((word) => `<span>${word}</span>`).join(" ");
        gsap.fromTo(
          copy.querySelectorAll("span"),
          { opacity: 0.12 },
          {
            opacity: 1,
            stagger: 0.05,
            ease: "none",
            scrollTrigger: {
              trigger: copy,
              start: "top 82%",
              end: "bottom 45%",
              scrub: 0.6,
            },
          },
        );
      }
    }
    const contactForm =
      document.querySelector<HTMLFormElement>("#contact-form");
    if (contactForm) {
      const messages: Record<string, string> = {
        firstName: "Please enter your first name.",
        lastName: "Please enter your last name.",
        email: "Please enter a valid email address.",
        subject: "Please add a subject.",
        message: "Please tell me a little about your project.",
      };
      const validate = (field: HTMLInputElement | HTMLTextAreaElement) => {
        const error = contactForm.querySelector<HTMLElement>(
          `#${field.id}-error`,
        );
        const invalid = !field.validity.valid;
        field.setAttribute("aria-invalid", String(invalid));
        if (error) error.textContent = invalid ? messages[field.name] : "";
        return !invalid;
      };
      contactForm
        .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
          "input, textarea",
        )
        .forEach((field) => {
          field.addEventListener("blur", () => validate(field));
          field.addEventListener("input", () => {
            if (field.getAttribute("aria-invalid") === "true") validate(field);
          });
        });
      contactForm.addEventListener("submit", (event) => {
        event.preventDefault();
        const fields = [
          ...contactForm.querySelectorAll<
            HTMLInputElement | HTMLTextAreaElement
          >("input, textarea"),
        ];
        const valid = fields.map(validate).every(Boolean);
        if (!valid) {
          fields.find((field) => !field.validity.valid)?.focus();
          return;
        }
      });
    }
  </script>

  <style is:global>
    @layer components {
      .portfolio_wrap {
        width: 100%;
        max-width: 100%;
        overflow-x: clip;
        background: var(--background);
        color: var(--text);
      }
      .portfolio-container {
        width: min(calc(100% - 2.5rem), 80rem);
        margin-inline: auto;
      }
      .portfolio-kicker {
        margin: 0;
        color: var(--accent);
        font-family: var(--label-family);
        font-size: 0.75rem;
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }
      .portfolio-heading_wrap {
        display: grid;
        gap: 1.4rem;
      }
      .portfolio-heading_wrap.centered {
        justify-items: center;
        text-align: center;
      }
      .portfolio-section_title {
        max-width: 13ch;
        margin: 0;
        color: var(--text);
        font-family: var(--display-family);
        font-size: clamp(2.75rem, 6vw, 5.5rem);
        font-weight: 500;
        line-height: 0.9;
        letter-spacing: -0.035em;
      }
      .portfolio-hero_wrap {
        position: relative;
        min-height: max(45rem, 100svh);
        overflow: hidden;
        isolation: isolate;
        scroll-margin-top: 6.5rem;
        color: #ffffff;
        background: #001827;
      }
      .portfolio-hero_ambient {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        background:
          radial-gradient(circle at 50% 50%, #01497c 0, transparent 36%),
          radial-gradient(circle at 12% 24%, #013a63 0, transparent 34%),
          linear-gradient(100deg, #00131f 0%, #012a4a 48%, #001018 100%);
      }
      .portfolio-hero_ambient::after {
        position: absolute;
        inset: 0;
        content: "";
        opacity: 0.14;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.22'/%3E%3C/svg%3E");
        mix-blend-mode: soft-light;
      }
      .portfolio-hero_circles {
        position: absolute;
        inset: 0;
        z-index: 1;
        pointer-events: none;
      }
      .portfolio-hero_circles span {
        position: absolute;
        top: 49%;
        left: 50%;
        aspect-ratio: 1;
        border-radius: 50%;
        transform: translate(-50%, -50%);
      }
      .portfolio-hero_circles span:nth-child(1) {
        width: clamp(30rem, 54vw, 51rem);
        background: rgba(1, 73, 124, 0.2);
      }
      .portfolio-hero_circles span:nth-child(2) {
        width: clamp(24rem, 43vw, 41rem);
        background: rgba(44, 125, 160, 0.13);
      }
      .portfolio-hero_circles span:nth-child(3) {
        width: clamp(18rem, 32vw, 31rem);
        background: rgba(70, 143, 175, 0.12);
      }
      .portfolio-hero_title {
        position: absolute;
        z-index: 2;
        top: clamp(7.5rem, 12vh, 9.5rem);
        left: 50%;
        width: min(100% - 2rem, 96rem);
        max-width: 96rem;
        margin: 0;
        color: #ffffff;
        font-family: var(--display-family);
        font-size: clamp(7rem, 15.2vw, 15rem);
        font-weight: 600;
        line-height: 0.78;
        letter-spacing: -0.065em;
        text-align: center;
        white-space: nowrap;
        transform: translateX(-50%);
      }
      .portfolio-hero_stage {
        position: absolute;
        z-index: 3;
        inset: 0;
        pointer-events: none;
      }
      .portfolio-hero_portrait {
        position: absolute;
        bottom: -7.5rem;
        left: 50%;
        width: clamp(30rem, 47vw, 43rem);
        transform: translateX(-50%);
      }
      .portfolio-hero_portrait img {
        width: 100%;
        height: auto;
        filter: contrast(1.08) drop-shadow(0 2rem 4rem rgba(0, 16, 24, 0.5));
        transition: transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
      }
      .portfolio-hero_portrait:hover img {
        transform: scale(1.025);
      }
      .portfolio-hero_left,
      .portfolio-hero_right {
        position: absolute;
        z-index: 4;
        width: min(17rem, 22vw);
      }
      .portfolio-hero_left {
        top: 52%;
        left: max(1.5rem, calc((100% - 87.5rem) / 2));
      }
      .portfolio-hero_right {
        top: 64%;
        right: max(1.5rem, calc((100% - 87.5rem) / 2));
      }
      .portfolio-hero_role {
        margin: 0 0 1rem;
        color: #61a5c2;
        font-family: var(--label-family);
        font-size: 0.68rem;
        font-weight: 600;
        line-height: 1.2;
        letter-spacing: 0.15em;
        text-transform: uppercase;
      }
      .portfolio-hero_text {
        margin: 0;
        color: #a9d6e5;
        font-size: clamp(0.76rem, 0.9vw, 0.9rem);
        font-weight: 400;
        line-height: 1.48;
      }
      .portfolio-hero_cta.button_wrap {
        gap: 0.8rem;
        min-height: 2.75rem;
        margin-top: 1rem;
        padding: 0.35rem 0.4rem 0.35rem 1.1rem;
        border-radius: 999rem;
        --button-background: #89c2d9;
        --button-text: #012a4a;
        --button-border: #89c2d9;
        --button-background-hover: #ffffff;
        --button-text-hover: #012a4a;
        --button-border-hover: #ffffff;
      }
      .portfolio-hero_cta .button_text {
        display: inline-flex;
        align-items: center;
        gap: 0.8rem;
        white-space: nowrap;
      }
      .portfolio-hero_cta-mark {
        display: grid;
        place-items: center;
        width: 2rem;
        aspect-ratio: 1;
        color: #012a4a;
        border-radius: 50%;
        background: #ffffff;
        transition: transform 0.22s ease-out;
      }
      .portfolio-hero_cta:hover .portfolio-hero_cta-mark {
        transform: translate(0.15rem, -0.15rem);
      }
      .portfolio-tech_wrap {
        padding-block: 1.5rem;
        border-block: 0.0625rem solid var(--border);
      }
      .portfolio-tech_marquee {
        width: min(calc(100% - 2.5rem), 87.5rem);
        margin-inline: auto;
      }
      .portfolio-tech_marquee .marquee_toggle {
        display: none;
      }
      .portfolio-tech_marquee .marquee_panel {
        gap: 3rem;
      }
      .portfolio-tech_item {
        display: inline-flex;
        align-items: center;
        gap: 3rem;
        color: var(--text-2);
        font-family: var(--label-family);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        white-space: nowrap;
      }
