---
import Hero from "@/components/Home/Hero.astro";
import Work from "@/components/Home/Work.astro";
import Services from "@/components/Home/Services.astro";
import Testimonials from "@/components/Home/Testimonials.astro";
import Process from "@/components/Home/Process.astro";
import Personal from "@/components/Home/Personal.astro";
import Contact from "@/components/Home/Contact.astro";
---

<div class="editorial-home_wrap">
  <Hero />
  <Work />
  <Services />
  <Testimonials />
  <Process />
  <Personal />
  <Contact />
</div>

<style is:global>
  @layer components {
    .editorial-home_wrap {
      --paper: #eef0e8;
      --ink: #071722;
      --navy: #071d2b;
      --accent-page: #089eb5;
      --accent-deep: #116f86;
      color: var(--ink);
      background: var(--paper);
      overflow-x: clip;
    }
    [data-theme="dark"] .editorial-home_wrap {
      --paper: #081721;
      --ink: #edf4f3;
      --navy: #031019;
      --accent-page: #30b8c9;
      --accent-deep: #68d2de;
    }
    .editorial-home_wrap :where(h1, h2, h3, p) {
      margin: 0;
    }
    .editorial-home_wrap :where(a, button, input, textarea):focus-visible {
      outline: 0.15rem solid var(--accent-page);
      outline-offset: 0.25rem;
    }
    .editorial-kicker {
      font: 600 0.72rem/1.2 var(--label-family);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .editorial-button,
    .editorial-submit {
      display: inline-flex;
      width: fit-content;
      height: 2.5rem;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      border: 0;
      border-radius: 100vw;
      padding-inline: 1.35rem;
      color: var(--paper);
      background: var(--ink);
      font-weight: 650;
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
      transition:
        transform 250ms ease,
        background 250ms ease;
    }
    .editorial-button:hover {
      background: var(--accent-deep);
      transform: translateY(-0.15rem);
    }
    .editorial-button:active,
    .editorial-submit:active {
      transform: scale(0.98);
    }
    .editorial-button.light,
    .editorial-submit {
      color: #071722;
      background: #eff8f7;
    }
    .editorial-button.light:hover {
      color: #eff8f7;
      background: #071722;
    }
    .editorial-submit:disabled {
      opacity: 0.55;
      cursor: wait;
    }
    .editorial-work_inner,
    .editorial-services_inner,
    .editorial-personal_inner,
    .editorial-testimonials_inner,
    .editorial-contact_inner {
      width: min(calc(100% - 2rem), 82rem);
      margin: auto;
    }
    .editorial-section_header {
      position: relative;
      z-index: 2;
      display: grid;
      gap: 1rem;
    }
    .editorial-section_header h2,
    .editorial-services_intro h2,
    .editorial-process_content h2,
    .editorial-personal_copy h2,
    .editorial-contact_copy h2 {
      max-width: 10ch;
      font-family: "Barlow Condensed", var(--display-family);
      font-size: clamp(3.8rem, 8vw, 7.8rem);
      font-weight: 800;
      line-height: 0.83;
      letter-spacing: -0.045em;
      text-transform: uppercase;
    }
    .editorial-services_wrap,
    .editorial-personal_wrap {
      padding-block: clamp(7rem, 13vw, 12rem);
    }
    .editorial-services_intro,
    .editorial-personal_copy,
    .editorial-contact_copy {
      display: grid;
      align-content: start;
      gap: 1.5rem;
    }
    .editorial-serif {
      max-width: 27ch;
      font:
        500 clamp(1.45rem, 2.5vw, 2.25rem)/1.25 "Fraunces",
        Georgia,
        serif;
    }
    @media (width >= 48rem) {
      .editorial-work_inner,
      .editorial-services_inner,
      .editorial-personal_inner,
      .editorial-testimonials_inner,
      .editorial-contact_inner {
        width: min(calc(100% - 4rem), 82rem);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .editorial-home_wrap *,
      .editorial-home_wrap *::before,
      .editorial-home_wrap *::after {
        animation: none !important;
        transition-duration: 0.01ms !important;
      }
    }
  }
</style>
