---
import { Image } from "astro:assets";
import Heading from "@/components/Typography/Heading.astro";
import comic from "@/assets/logo/comic.png";
import formal from "@/assets/logo/formal.png";
import { projects } from "@/data/projects.ts";
import { services } from "@/data/services.ts";
import { SCHEDULE_URL } from "@/consts.ts";

const process = [
  ["Discover", "Goals, users, constraints, and the real problem come first."],
  [
    "Research",
    "References and competitors reveal what to keep and what to question.",
  ],
  ["Structure", "Content and journeys become a clear, useful experience."],
  [
    "Design",
    "Layouts and interactions are tested before they become expensive.",
  ],
  ["Build", "The approved direction becomes an accessible, fast product."],
];
---

<div class="editorial-home_wrap">
  <section class="editorial-hero_wrap" aria-labelledby="hero-title">
    <div class="editorial-hero_shape" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="editorial-hero_inner">
      <p class="editorial-kicker">Design and development, working together</p>
      <Heading
        tag="h1"
        variant="inherit"
        id="hero-title"
        class="editorial-hero_title"
        >Useful digital<br /><em>experiences.</em></Heading
      >
      <div class="editorial-hero_bottom">
        <p>
          I design and build clear, responsive websites for businesses that care
          about how their work is understood.
        </p>
        <a class="editorial-button" href="#work"
          >See selected work <i
            class="ph ph-arrow-down-right"
            aria-hidden="true"></i></a
        >
      </div>
    </div>
  </section>

  <section class="editorial-work_wrap" id="work" aria-labelledby="work-title">
    <div class="editorial-work_inner">
      <header class="editorial-section_header">
        <p class="editorial-kicker">Selected projects</p><Heading
          tag="h2"
          variant="inherit"
          id="work-title">Work that earns attention.</Heading
        >
      </header>
      <div class="editorial-work_word" aria-hidden="true">WORK</div>
      <div class="editorial-projects_list">
        {
          projects.map((project, index) => (
            <a
              class="editorial-project_card"
              href={`/projects/${project.slug}`}
              style={`--card-index:${index}`}
            >
              <div class="editorial-project_media">
                <Image
                  src={project.image}
                  alt={project.imageAlt}
                  widths={[480, 720, 960]}
                  sizes="(max-width: 48rem) 86vw, 25vw"
                  loading={index < 3 ? "eager" : "lazy"}
                />
              </div>
              <div class="editorial-project_copy">
                <>
                  <div>
                    <>
                      <p>{project.category}</p>
                      <h3>{project.title}</h3>
                    </>
                  </div>
                  <i class="ph ph-arrow-up-right" aria-hidden="true" />
                  <span>{project.role}</span>
                </>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section
    class="editorial-services_wrap"
    id="services"
    aria-labelledby="services-title"
  >
    <div class="editorial-services_inner">
      <div class="editorial-services_intro">
        <p class="editorial-kicker">Services</p><Heading
          tag="h2"
          variant="inherit"
          id="services-title">From first question to finished product.</Heading
        ><p class="editorial-serif">
          Strategy, design, and engineering stay connected, so good ideas
          survive implementation.
        </p>
      </div>
      <ol class="editorial-services_list">
        {
          services.map((service) => (
            <li>
              <>
                <a href={`/services/${service.slug}`}>
                  <>
                    <span>{service.title}</span>
                    <i class="ph ph-arrow-up-right" aria-hidden="true" />
                  </>
                </a>
                <p>{service.homepageCopy}</p>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section
    class="editorial-process_outer"
    id="about"
    aria-labelledby="process-title"
  >
    <div class="editorial-process_wrap">
      <div class="editorial-process_art" aria-hidden="true">
        <div class="editorial-process_orbit"></div><Image
          src={comic}
          alt=""
          widths={[420, 640]}
          sizes="(max-width: 48rem) 80vw, 38vw"
          loading="lazy"
        />
      </div>
      <div class="editorial-process_content">
        <p class="editorial-kicker">How I work</p><Heading
          tag="h2"
          variant="inherit"
          id="process-title">A practical process with room to think.</Heading
        ><ol>
          {
            process.map(([title, description]) => (
              <li>
                <>
                  <h3>{title}</h3>
                  <p>{description}</p>
                </>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <section class="editorial-personal_wrap" aria-labelledby="personal-title">
    <div class="editorial-personal_inner">
      <div class="editorial-personal_copy">
        <p class="editorial-kicker">One person, both disciplines</p><Heading
          tag="h2"
          variant="inherit"
          id="personal-title">Design decisions stay close to the code.</Heading
        ><p class="editorial-serif">
          Kiguidev is my independent practice. I bring product thinking and
          front-end engineering into one focused collaboration.
        </p>
      </div>
      <div class="editorial-personal_portrait">
        <Image
          src={formal}
          alt="Guillermo, the designer and developer behind Kiguidev"
          widths={[480, 720, 960]}
          sizes="(max-width: 48rem) 100vw, 42vw"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <section
    class="editorial-contact_wrap"
    id="contact"
    aria-labelledby="contact-title"
  >
    <div class="editorial-contact_inner">
      <div class="editorial-contact_copy">
        <p class="editorial-kicker">Start a conversation</p><Heading
          tag="h2"
          variant="inherit"
          id="contact-title">Have a project in mind?</Heading
        ><p>
          Non of the available hours fits you for a call? or there's no space in my schedule? You can also reach me by email at
          <a href="mailto:guillermo.obando@kiguidev.me"> guillermo.obando@kiguidev.me</a>.
        </p>
        <!-- <a
          class="editorial-button light"
          href={SCHEDULE_URL}
          target="_blank"
          rel="noopener noreferrer"
          >Schedule a call <i
            class="ph ph-arrow-up-right"
            aria-hidden="true"></i></a
        > -->
      </div>
      <form
        class="editorial-contact_form"
        id="contact-form"
        name="lead-qualification"
        method="POST"
        action="/.netlify/functions/submit-lead"
        data-lead-form
        novalidate
      >
        <input type="hidden" name="language" value="en" />
        <input type="text" name="website" class="editorial-contact_honeypot" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <div class="editorial-step" data-step="1">
          <p class="editorial-step-label">Step 1 of 6</p><label for="service">What service do you need?</label>
          <select id="service" name="service" required><option value="">Choose a service</option><option>Website Development</option><option>Website Redesign</option><option>Local SEO &amp; Geographic SEO</option><option>Mobile Enhacement</option><option>Other / Not Sure Yet</option></select>
        </div>
        <div class="editorial-step" data-step="2" hidden><p class="editorial-step-label">Step 2 of 6</p><label for="description">Tell me about your project.</label><textarea id="description" name="description" class="editorial-textarea" rows="5" minlength="20" maxlength="3000" required placeholder="Business goals, current website, requirements, and desired outcomes"></textarea><span class="editorial-hint"><span class="character-count">0</span>/3,000 characters</span></div>
        <div class="editorial-step" data-step="3" hidden><p class="editorial-step-label">Step 3 of 6</p><label for="budget">What's your estimated budget?</label><select id="budget" name="budget" required><option value="">Choose a range</option><option>Under $500</option><option>$500–$1,500</option><option>$1,500–$3,000</option><option>Over $3,000</option><option>Not sure yet</option></select></div>
        <div class="editorial-step" data-step="4" hidden><p class="editorial-step-label">Step 4 of 6</p><label for="timeline">When would you like to get started?</label><select id="timeline" name="timeline" required><option value="">Choose a timeline</option><option>As soon as possible</option><option>Within a month</option><option>Within three months</option><option>Just exploring</option></select></div>
        <div class="editorial-step" data-step="5" hidden><p class="editorial-step-label">Step 5 of 6</p><label for="decision">Who will make the final decision?</label><select id="decision" name="decision" required><option value="">Choose one</option><option>I am the decision-maker</option><option>We make decisions as a team</option><option>I need approval from someone else</option></select></div>
        <div class="editorial-step" data-step="6" hidden><p class="editorial-step-label">Step 6 of 6</p>
        <div class="editorial-field wide"><label for="full-name">Full name</label><input id="full-name" name="name" autocomplete="name" required /></div>
        <div class="editorial-field wide">
          <label for="email">Email</label><input
            id="email"
            name="email"
            type="email"
            autocomplete="email"
            required
            aria-describedby="email-error"
          /><span id="email-error"></span>
        </div>
        <div class="editorial-field"><label for="company">Company (optional)</label><input id="company" name="company" autocomplete="organization" /></div>
        <div class="editorial-field"><label for="website-url">Website (optional)</label><input id="website-url" name="websiteUrl" type="url" autocomplete="url" /></div>
        <div class="editorial-consent wide">
          <label for="privacy-consent"
            ><input
              id="privacy-consent"
              name="privacyConsent"
              type="checkbox"
              value="accepted"
              required
              aria-describedby="privacy-consent-error"
            /><span
              >I have read the <a
                href="/privacy-policy"
                target="_blank"
                rel="noopener noreferrer">Privacy Policy</a
              > and consent to the processing and international transfer of my information
              so Kiguidev can respond to my inquiry.</span
            ></label
          ><span id="privacy-consent-error"></span>
        </div>
        </div>
        <div class="editorial-step-actions wide"><button class="editorial-step-back" type="button" data-back hidden>Back</button><button class="editorial-submit" type="button" data-next>Continue</button><button class="editorial-submit" type="submit" data-submit hidden>Send inquiry</button></div>
        <p class="editorial-error wide" data-error role="alert"></p>
        <p class="editorial-status wide" role="status" aria-live="polite"></p>
        <div class="editorial-success wide" data-success hidden><strong>Thanks — your inquiry has been received.</strong><p>I’ll review the details and follow up by email.</p><a class="editorial-button light" data-calendly href={SCHEDULE_URL} target="_blank" rel="noopener noreferrer" hidden>Schedule a Discovery Call <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a></div>
      </form>
    </div>
  </section>
</div>



<script>
  import gsap from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";
  gsap.registerPlugin(ScrollTrigger);
  let context: gsap.Context | undefined;
  let formController: AbortController | undefined;
  const initializeMotion = () => {
    context?.revert();
    const root = document.querySelector<HTMLElement>(".editorial-home_wrap");
    if (!root || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    context = gsap.context(() => {
      gsap.fromTo(
        ".editorial-hero_inner > *",
        { opacity: 0, y: 28 },
        { opacity: 1, y: 0, duration: 0.85, stagger: 0.1, ease: "power3.out" },
      );
      gsap.to(".editorial-hero_shape span", {
        rotate: 360,
        duration: 24,
        repeat: -1,
        ease: "none",
        stagger: 2,
      });
      [
        ".editorial-section_header",
        ".editorial-services_intro",
        ".editorial-process_content",
        ".editorial-personal_copy",
        ".editorial-contact_copy",
      ].forEach((selector) =>
        gsap.fromTo(
          selector,
          { y: 24 },
          {
            y: 0,
            duration: 0.7,
            ease: "power2.out",
            scrollTrigger: { trigger: selector, start: "top 82%", once: true },
          },
        ),
      );
      gsap.fromTo(
        ".editorial-project_card",
        { y: 48 },
        {
          y: 0,
          duration: 0.85,
          stagger: 0.09,
          ease: "power3.out",
          scrollTrigger: {
            trigger: ".editorial-projects_list",
            start: "top 78%",
            once: true,
          },
        },
      );
    }, root);
  };
  const initializeForm = () => {
    formController?.abort();
    formController = new AbortController();
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    if (!form) return;
    const status = form.querySelector<HTMLElement>(".editorial-status");
    const error = form.querySelector<HTMLElement>("[data-error]");
    const steps = [...form.querySelectorAll<HTMLElement>("[data-step]")];
    const next = form.querySelector<HTMLButtonElement>("[data-next]");
    const back = form.querySelector<HTMLButtonElement>("[data-back]");
    const submit = form.querySelector<HTMLButtonElement>("[data-submit]");
    const success = form.querySelector<HTMLElement>("[data-success]");
    const calendly = form.querySelector<HTMLAnchorElement>("[data-calendly]");
    let current = 0;
    const analytics = (event: string) => window.dispatchEvent(new CustomEvent("kiguidev:analytics", { detail: { event } }));
    const renderStep = (focus = false) => {
      steps.forEach((step, index) => { step.hidden = index !== current; });
      if (back) back.hidden = current === 0;
      if (next) next.hidden = current === steps.length - 1;
      if (submit) submit.hidden = current !== steps.length - 1;
      if (focus) steps[current]?.querySelector<HTMLElement>("input, select, textarea")?.focus();
    };
    const validateStep = () => {
      const fields = [...(steps[current]?.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>("input[required], select[required], textarea[required]") ?? [])];
      const invalid = fields.find((field) => !field.checkValidity());
      if (invalid) {
        invalid.focus();
        invalid.reportValidity();
        analytics("lead_form_validation_failed");
        return false;
      }
      return true;
    };
    renderStep();
    analytics("lead_form_opened");
    next?.addEventListener("click", () => {
      if (!validateStep()) return;
      current++;
      analytics("lead_form_step_completed");
      renderStep(true);
    }, { signal: formController.signal });
    back?.addEventListener("click", () => { current--; renderStep(true); }, { signal: formController.signal });
    form.addEventListener(
      "submit",
      async (event) => {
        event.preventDefault();
        if (!validateStep()) return;
        const button = form.querySelector<HTMLButtonElement>(
          "[data-submit]",
        );
        if (button) button.disabled = true;
        if (next) next.disabled = true;
        if (status) status.textContent = "Sending your inquiry...";
        if (error) error.textContent = "";
        let failureReason = "The form service could not be reached.";
        try {
          const response = await fetch(form.action, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(Object.fromEntries(new FormData(form).entries())),
          });
          const result = await response.json().catch(() => ({}));
          if (!response.ok) {
            failureReason = response.status === 503
              ? "Email delivery is not configured on the server."
              : `The email service returned an error (HTTP ${response.status}).`;
            throw new Error("Submission failed");
          }
          analytics("lead_form_submitted");
          form.querySelectorAll<HTMLElement>("[data-step], .editorial-step-actions, .editorial-error, .editorial-status").forEach((el) => { el.hidden = true; });
          if (success) success.hidden = false;
          if (calendly && result.priority === "high") calendly.hidden = false;
          success?.querySelector("strong")?.focus();
        } catch {
          analytics("lead_form_submission_failed");
          if (status) status.textContent = "";
          if (error) error.textContent = `${failureReason} Please try again or email guillermo.obando@kiguidev.me.`;
        } finally {
          if (button) button.disabled = false;
          if (next) next.disabled = false;
        }
      },
      { signal: formController.signal },
    );
    calendly?.addEventListener("click", () => analytics("lead_calendly_clicked"), { signal: formController.signal });
  };
  const initialize = () => {
    initializeMotion();
    initializeForm();
  };
  initialize();
  document.addEventListener("astro:page-load", initialize);
  document.addEventListener("astro:before-swap", () => {
    context?.revert();
    formController?.abort();
  });
  const textArea = document.querySelector<HTMLTextAreaElement>("#description");
  const counter = document.querySelector<HTMLElement>(".character-count");

    if (textArea && counter) {
      const updateCounter = () => {
        counter.textContent = textArea.value.length.toLocaleString("en-US");
      };

      textArea.addEventListener("input", updateCounter);

      // Initialize counter if the field already contains text.
      updateCounter();
    }

</script>

<style>
  @layer components {
    .editorial-home_wrap {
      --paper: #eef0e8;
      --ink: #071722;
      --navy: #071d2b;
      --accent-page: #089eb5;
      --accent-deep: #116f86;
      color: var(--ink);
      background: var(--paper);
      overflow-x: clip;
    }
    :global([data-theme="dark"]) .editorial-home_wrap {
      --paper: #081721;
      --ink: #edf4f3;
      --navy: #031019;
      --accent-page: #30b8c9;
      --accent-deep: #68d2de;
    }
    .editorial-home_wrap :where(h1, h2, h3, p) {
      margin: 0;
    }
    .editorial-home_wrap :where(a, button, input, textarea):focus-visible {
      outline: 0.15rem solid var(--accent-page);
      outline-offset: 0.25rem;
    }
    .editorial-kicker {
      font: 600 0.72rem/1.2 var(--label-family);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }
    .editorial-hero_wrap {
      position: relative;
      min-height: 100dvh;
      overflow: hidden;
    }
    .editorial-hero_inner {
      position: relative;
      z-index: 2;
      display: grid;
      min-height: 100dvh;
      align-content: center;
      width: min(calc(100% - 2rem), 86rem);
      margin: auto;
      padding-block: 6rem 3rem;
    }
    .editorial-hero_title {
      max-width: 10ch;
      margin-top: 1.5rem;
      font-family: "Barlow Condensed", var(--display-family);
      font-size: clamp(5rem, 13vw, 11.5rem);
      font-weight: 800;
      line-height: 0.75;
      letter-spacing: -0.055em;
      text-transform: uppercase;
    }
    .editorial-hero_title em {
      color: var(--accent-page);
      font-family: "Fraunces", Georgia, serif;
      font-size: 0.69em;
      font-weight: 500;
      line-height: 1.1;
      text-transform: none;
    }
    .editorial-hero_bottom {
      display: grid;
      align-items: end;
      gap: 1.5rem;
      max-width: 58rem;
      margin-top: clamp(3rem, 8vh, 7rem);
    }
    .editorial-hero_bottom > p {
      max-width: 31rem;
      font-size: clamp(1rem, 1.5vw, 1.25rem);
      line-height: 1.5;
    }
    .editorial-button,
    .editorial-submit {
      display: inline-flex;
      width: fit-content;
      height: 2.5rem;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      border: 0;
      border-radius: 100vw;
      padding-inline: 1.35rem;
      color: var(--paper);
      background: var(--ink);
      font-weight: 650;
      text-decoration: none;
      white-space: nowrap;
      cursor: pointer;
      transition:
        transform 250ms ease,
        background 250ms ease;
    }
    .editorial-textarea{
      resize:none;
    }
    .editorial-textarea::placeholder {
      color: #ffffff;
    }
    .editorial-button:hover {
      background: var(--accent-deep);
      transform: translateY(-0.15rem);
    }
    .editorial-button:active,
    .editorial-submit:active {
      transform: scale(0.98);
    }
    .editorial-hero_shape {
      position: absolute;
      top: 8%;
      right: -6%;
      width: min(55vw, 48rem);
      aspect-ratio: 1;
      opacity: 0.78;
    }
    .editorial-hero_shape span {
      position: absolute;
      inset: 12%;
      border-radius: 42% 58% 64% 36%/42% 34% 66% 58%;
      background: color-mix(in srgb, var(--accent-page) 68%, #8067c8);
    }
    .editorial-hero_shape span:nth-child(2) {
      inset: 20%;
      background: color-mix(in srgb, var(--paper) 55%, transparent);
      transform: rotate(45deg);
    }
    .editorial-hero_shape span:nth-child(3) {
      inset: 31%;
      background: var(--accent-page);
      opacity: 0.7;
      transform: rotate(90deg);
    }
    .editorial-work_wrap {
      position: relative;
      overflow: hidden;
      padding-block: clamp(6rem, 12vw, 11rem);
      color: #06131d;
      background: #88d6de;
    }
    :global([data-theme="dark"]) .editorial-work_wrap {
      color: #eaf7f6;
      background: #105669;
    }
    .editorial-work_inner,
    .editorial-services_inner,
    .editorial-personal_inner,
    .editorial-contact_inner {
      width: min(calc(100% - 2rem), 82rem);
      margin: auto;
    }
    .editorial-section_header {
      position: relative;
      z-index: 2;
      display: grid;
      gap: 1rem;
    }
    .editorial-section_header h2,
    .editorial-services_intro h2,
    .editorial-process_content h2,
    .editorial-personal_copy h2,
    .editorial-contact_copy h2 {
      max-width: 10ch;
      font-family: "Barlow Condensed", var(--display-family);
      font-size: clamp(3.8rem, 8vw, 7.8rem);
      font-weight: 800;
      line-height: 0.83;
      letter-spacing: -0.045em;
      text-transform: uppercase;
    }
    .editorial-work_word {
      margin: clamp(4rem, 8vw, 7rem) -4vw -3vw;
      font:
        800 clamp(12rem, 37vw, 35rem)/0.54 "Barlow Condensed",
        sans-serif;
      letter-spacing: -0.07em;
      opacity: 0.14;
      white-space: nowrap;
    }
    .editorial-projects_list {
      position: relative;
      z-index: 2;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      align-items: center;
      margin-top: -6vw;
      padding-inline: 2vw;
    }
    .editorial-project_card {
      display: grid;
      overflow: hidden;
      border-radius: 1rem;
      color: #071722;
      background: #f2f3eb;
      box-shadow: 0 1.5rem 3.5rem rgb(5 31 42/18%);
      text-decoration: none;
      transform: rotate(calc((var(--card-index) - 2) * 2deg));
      transition:
        transform 350ms cubic-bezier(0.16, 1, 0.3, 1),
        box-shadow 350ms;
    }
    .editorial-project_card + .editorial-project_card {
      margin-left: -18%;
    }
    .editorial-project_card:nth-child(2n) {
      transform: translateY(2rem) rotate(3deg);
    }
    .editorial-project_card:hover,
    .editorial-project_card:focus-visible {
      position: relative;
      z-index: 4;
      transform: translateY(-1.5rem) rotate(0);
      box-shadow: 0 2.4rem 5rem rgb(5 31 42/28%);
    }
    .editorial-project_media {
      aspect-ratio: 4/5;
      overflow: hidden;
    }
    .editorial-project_media :global(img) {
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 500ms;
    }
    .editorial-project_card:hover .editorial-project_media :global(img) {
