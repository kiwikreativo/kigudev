---
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Slider from "@/components/Interactive/Slider.astro";
import Marquee from "@/components/Interactive/Marquee.astro";
import UnicornBackground from "@/components/Media/UnicornBackground.astro";
import comic from "@/assets/logo/comic.png";
import { services } from "@/data/services.ts";
import { projects } from "@/data/projects.ts";

const processSteps = [
  {
    title: "Discovery",
    description:
      "Understanding the project, business goals, requirements, and the problem that needs to be solved.",
    icon: "ph-eye",
  },
  {
    title: "Research",
    description:
      "Understanding users, references, competitors, and the context surrounding the product.",
    icon: "ph-magnifying-glass",
  },
  {
    title: "Structure",
    description:
      "Turning requirements into clear information architecture, user flows, and interface structure.",
    icon: "ph-tree-structure",
  },
  {
    title: "Design",
    description:
      "Exploring layouts, wireframes, interaction patterns, and prototypes before implementation.",
    icon: "ph-pencil-ruler",
  },
  {
    title: "Development",
    description:
      "Building the approved experience into a responsive, accessible, and performant interface.",
    icon: "ph-code",
  },
];
---

<div class="portfolio_wrap">
  <section class="portfolio-hero_wrap" aria-labelledby="hero-title">
    <div class="portfolio-hero_ambient" aria-hidden="true"></div>
    <div class="portfolio-hero_circles" aria-hidden="true">
      <span></span><span></span><span></span>
    </div>
    <div class="portfolio-hero_layout">
      <Heading
        tag="h1"
        variant="inherit"
        id="hero-title"
        class="portfolio-hero_title">KIGUDEV</Heading
      >
      <div class="portfolio-hero_stage">
        <div class="portfolio-hero_portrait">
          <Image
            src={comic}
            alt="Illustrated portrait of Kigudev"
            widths={[320, 480, 640]}
            class="hero-image"
            sizes="(max-width: 48rem) 95vw, (max-width: 64rem) 37rem, 43rem"
            loading="eager"
          />
        </div>
      </div>
      <div class="portfolio-hero_left">
        <p class="portfolio-hero_role">Software engineer + UI/UX</p>
        <Paragraph class="portfolio-hero_text"
          >I design and build thoughtful digital experiences with a focus on
          usability, performance, and clarity.</Paragraph
        >
      </div>
      <div class="portfolio-hero_right">
        <Paragraph class="portfolio-hero_text"
          >Merging design thinking with software engineering to create digital
          experiences that are intuitive, efficient, and thoughtfully built.</Paragraph
        >
        <Button element="link" href="#contact" class="portfolio-hero_cta"
          >Start a project <span
            class="portfolio-hero_cta-mark"
            aria-hidden="true"><i class="ph ph-arrow-up-right"></i></span
          ></Button
        >
      </div>
    </div>
  </section>

  <div class="portfolio-post-hero_wrap">
    <UnicornBackground />
    <div class="portfolio-post-hero_content">
      <section class="portfolio-tech_wrap" aria-label="Services">
        <Marquee label="Services" class="portfolio-tech_marquee">
          {
            [
              "UI/UX Design",
              "Web Design",
              "Web Development",
              "Responsive Design",
              "Mobile Enhancement",
              "SEO",
              "Landing Pages",
              "E-commerce",
              "Design Systems",
              "Website Redesign",
            ].map((item) => <span class="portfolio-tech_item">{item}</span>)
          }
        </Marquee>
      </section>

      <section
        class="portfolio-work_wrap"
        id="work"
        aria-labelledby="work-title"
      >
        <div class="portfolio-container portfolio-work_inner">
          <span class="portfolio-decor portfolio-decor_work" aria-hidden="true"
            >&lt;/&gt;</span
          >
          <div class="portfolio-heading_wrap centered">
            <p class="portfolio-kicker">Selected projects</p><Heading
              tag="h2"
              variant="inherit"
              id="work-title"
              class="portfolio-section_title">Work made to be useful</Heading
            >
          </div>
          <Slider
            variant="contained"
            xsmall={1}
            class="portfolio-work_slider"
            label="Selected Kigudev projects"
          >
            {
              projects.map((project, index) => (
                <article class="portfolio-project_wrap">
                  <div class="portfolio-project_media">
                    <Image
                      src={project.image}
                      alt={project.imageAlt}
                      widths={[480, 720, 960, 1280, 1600]}
                      sizes="(max-width: 48rem) 100vw, 62vw"
                      loading={index === 0 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : "auto"}
                    />
                  </div>
                  <div class="portfolio-project_content">
                    <p class="portfolio-project_category">{project.category}</p>
                    <Heading
                      tag="h3"
                      variant="inherit"
                      class="portfolio-project_title"
                    >
                      {project.title}
                    </Heading>
                    <Paragraph class="portfolio-project_text">
                      {project.shortDescription}
                    </Paragraph>
                    <dl class="portfolio-project_meta">
                      <>
                        <div>
                          <>
                            <dt>Role</dt>
                            <dd>{project.role}</dd>
                          </>
                        </div>
                        <div>
                          <>
                            <dt>Focus</dt>
                            <dd>{project.focus}</dd>
                          </>
                        </div>
                        <div>
                          <>
                            <dt>Timeline</dt>
                            <dd>{project.duration}</dd>
                          </>
                        </div>
                      </>
                    </dl>
                    <Button
                      element="link"
                      href={`/projects/${project.slug}`}
                      emphasis="secondary"
                    >
                      View Project{" "}
                      <i class="ph ph-arrow-up-right" aria-hidden="true" />
                    </Button>
                    <p class="portfolio-project_credit">
                      Photo by{" "}
                      <a
                        href={project.photoUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {project.photoCredit} on Pexels
                      </a>
                    </p>
                  </div>
                </article>
              ))
            }
          </Slider>
        </div>
      </section>

      <section
        class="portfolio-services_wrap"
        id="services"
        aria-labelledby="services-title"
      >
        <div class="portfolio-container">
          <span
            class="portfolio-decor portfolio-decor_services"
            aria-hidden="true">[ + ]</span
          >
          <div class="portfolio-heading_wrap">
            <p class="portfolio-kicker">Services</p>
            <Heading
              tag="h2"
              variant="inherit"
              id="services-title"
              class="portfolio-section_title">I can help you with</Heading
            >
          </div>
          <div class="portfolio-services_list">
            {
              services.map((service, index) => (
                <a
                  href={`/services/${service.slug}`}
                  class:list={[
                    "portfolio-service_item",
                    index === 3 && "is-active",
                  ]}
                >
                  <span class="portfolio-service_number">{service.number}</span>
                  <div class="portfolio-service_copy">
                    <Heading
                      tag="h3"
                      variant="inherit"
                      class="portfolio-service_title"
                    >
                      {service.title}
                    </Heading>
                    <Paragraph class="portfolio-service_text">
                      {service.homepageCopy}
                    </Paragraph>
                  </div>
                  <div class="portfolio-service_reveal">
                    <span>{service.homepageDetail}</span>
                  </div>
                  <span class="portfolio-service_arrow" aria-hidden="true">
                    <i class="ph ph-arrow-up-right" />
                  </span>
                </a>
              ))
            }
          </div>
        </div>
      </section>

      <section
        class="portfolio-about_wrap"
        id="about"
        aria-labelledby="about-title"
      >
        <div class="portfolio-container portfolio-about_inner">
          <header class="portfolio-about_header">
            <span class="portfolio-about_index">02</span>
            <span class="portfolio-about_label">My approach</span>
            <span class="portfolio-about_direction" aria-hidden="true"
              >&gt;&gt;&gt;</span
            >
          </header>
          <div class="portfolio-about_intro">
            <span
              class="portfolio-decor portfolio-decor_crosshair"
              aria-hidden="true">+</span
            >
            <Heading
              tag="h2"
              variant="inherit"
              id="about-title"
              class="portfolio-about_title"
              ><span class="portfolio-about_line"
                ><span data-reveal-word>Designing</span></span
              ><span class="portfolio-about_line"
                ><span data-reveal-word>A</span>&nbsp;<span data-reveal-word
                  >Better</span
                ></span
              ><span class="portfolio-about_line"
                ><span data-reveal-word>Experience</span></span
              ></Heading
            >
            <p class="portfolio-about_annotation">
              For thoughtful<br />digital experiences<br />built around<br
              />real people
            </p>
          </div>
          <div class="portfolio-process_wrap">
            <span
              class="portfolio-decor portfolio-decor_coordinates"
              aria-hidden="true">X:05 / Y:24</span
            >
            <ol class="portfolio-process_list">
              {
                processSteps.map((step, index) => (
                  <li class="portfolio-process_item">
                    <div class="portfolio-process_heading">
                      <i class={`ph ${step.icon}`} aria-hidden="true" />
                      <h3>
                        <span>{String(index + 1).padStart(2, "0")}.</span>{" "}
                        {step.title}
                      </h3>
                    </div>
                    <p>{step.description}</p>
                  </li>
                ))
              }
            </ol>
            <div class="portfolio-process_connector" aria-hidden="true">
              {processSteps.map(() => <span />)}
            </div>
          </div>
        </div>
      </section>

      <section
        class="portfolio-contact_wrap"
        id="contact"
        aria-labelledby="contact-title"
      >
        <div class="portfolio-contact_inner">
          <span
            class="portfolio-decor portfolio-decor_contact"
            aria-hidden="true">&#123; &#125;</span
          >
          <div class="portfolio-contact_copy">
            <p class="portfolio-kicker">Start a conversation</p>
            <Heading
              tag="h2"
              variant="inherit"
              id="contact-title"
              class="portfolio-contact_title"
              >Tell me about your next <span>project.</span></Heading
            >
            <p class="portfolio-contact_text">
              Share what you are building, improving, or trying to clarify. I
              will review the details and get back to you with a practical next
              step.
            </p>
          </div>
          <form
            class="portfolio-contact_form"
            id="contact-form"
            name="portfolio-contact"
            method="POST"
            action="/"
            data-netlify="true"
            netlify-honeypot="bot-field"
            novalidate
          >
            <input type="hidden" name="form-name" value="portfolio-contact" />
            <p class="portfolio-contact_honeypot" hidden>
              <label>
                Do not fill this out: <input name="bot-field" tabindex="-1" />
              </label>
            </p>
            <div class="portfolio-contact_field">
              <label for="first-name">First Name</label><input
                id="first-name"
                name="firstName"
                autocomplete="given-name"
                required
                aria-describedby="first-name-error"
              /><span class="portfolio-contact_error" id="first-name-error"
              ></span>
            </div>
            <div class="portfolio-contact_field">
              <label for="last-name">Last Name</label><input
                id="last-name"
                name="lastName"
                autocomplete="family-name"
                required
                aria-describedby="last-name-error"
              /><span class="portfolio-contact_error" id="last-name-error"
              ></span>
            </div>
            <div class="portfolio-contact_field wide">
              <label for="email">Email</label><input
                id="email"
                name="email"
                type="email"
                autocomplete="email"
                required
                aria-describedby="email-error"
              /><span class="portfolio-contact_error" id="email-error"></span>
            </div>
            <div class="portfolio-contact_field wide">
              <label for="subject">Subject</label><input
                id="subject"
                name="subject"
                required
                aria-describedby="subject-error"
              /><span class="portfolio-contact_error" id="subject-error"></span>
            </div>
            <div class="portfolio-contact_field wide">
              <label for="message">Message</label><textarea
                id="message"
                name="message"
                rows="6"
                required
                aria-describedby="message-error"></textarea><span
                class="portfolio-contact_error"
                id="message-error"></span>
            </div>
            <div class="portfolio-contact_consent wide">
              <label for="privacy-consent">
                <input
                  id="privacy-consent"
                  name="privacyConsent"
                  type="checkbox"
                  value="accepted"
                  required
                  aria-describedby="privacy-consent-error"
                />
                <span>
                  I have read the <a
                    href="/privacy-policy"
                    target="_blank"
                    rel="noopener noreferrer">Privacy Policy</a
                  > and consent to the processing and international transfer of my
                  information so Kigudev can respond to my inquiry.
                </span>
              </label>
              <span class="portfolio-contact_error" id="privacy-consent-error"
              ></span>
            </div>
            <div class="portfolio-contact_submit wide">
              <button type="submit"
                >Send Message <i
                  class="ph ph-paper-plane-tilt"
                  aria-hidden="true"></i></button
              >
            </div>
            <p
              class="portfolio-contact_status wide"
              role="status"
              aria-live="polite"
            >
            </p>
          </form>
        </div>
      </section>
    </div>
  </div>

  <script>
    import gsap from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    gsap.registerPlugin(ScrollTrigger);

    let motionContext: gsap.Context | undefined;
    let serviceInteractionController: AbortController | undefined;

    const initializePortfolioMotion = () => {
      const portfolio = document.querySelector<HTMLElement>(".portfolio_wrap");
      if (
        !portfolio ||
        portfolio.dataset.motionReady ||
        matchMedia("(prefers-reduced-motion: reduce)").matches
      )
        return;

      portfolio.dataset.motionReady = "true";
      motionContext = gsap.context(() => {
        const reveal = (
          trigger: gsap.DOMTarget,
          targets: gsap.TweenTarget,
          stagger = 0.06,
          y = 18,
        ) =>
          ScrollTrigger.create({
            trigger,
            start: "top 84%",
            once: true,
            onEnter: () =>
              gsap.fromTo(
                targets,
                { y, opacity: 0 },
                {
                  y: 0,
                  opacity: 1,
                  duration: 0.62,
                  stagger,
                  ease: "power2.out",
                },
              ),
          });

        gsap.fromTo(
          ".nav_wrap",
          { y: -12, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.55, ease: "power2.out" },
        );
        gsap.fromTo(
          [
            ".portfolio-hero_title",
            ".portfolio-hero_left",
            ".portfolio-hero_right",
          ],
          { y: 14, opacity: 0 },
          {
            y: 0,
            opacity: 1,
            duration: 0.7,
            stagger: 0.08,
            ease: "power2.out",
          },
        );
        gsap.fromTo(
          ".portfolio-hero_portrait",
          { y: 20, opacity: 0 },
          { y: 0, opacity: 1, duration: 0.8, ease: "power2.out" },
        );

        reveal(".portfolio-tech_wrap", ".portfolio-tech_marquee", 0, 12);
        reveal(
          ".portfolio-work_wrap",
          ".portfolio-work_wrap .portfolio-heading_wrap > *",
        );
        reveal(
          ".portfolio-work_slider",
          [
            ".portfolio-project_content > *",
            ".portfolio-work_slider .slider_controls",
          ],
          0.05,
          16,
        );
        gsap.utils
          .toArray<HTMLElement>(".portfolio-project_media")
          .forEach((media) =>
            gsap.fromTo(
              media,
              { scale: 0.88, opacity: 0.45 },
              {
                scale: 1,
                opacity: 1,
                ease: "none",
                scrollTrigger: {
                  trigger: media,
                  start: "top 88%",
                  end: "center 52%",
                  scrub: 0.7,
                },
              },
            ),
          );

        reveal(
          ".portfolio-services_wrap",
          ".portfolio-services_wrap .portfolio-heading_wrap > *",
        );
        reveal(
          ".portfolio-about_wrap",
          [".portfolio-about_header", ".portfolio-about_intro > *"],
          0.07,
        );
        reveal(".portfolio-contact_wrap", ".portfolio-contact_copy > *", 0.06);
        reveal(
          ".portfolio-contact_form",
          [".portfolio-contact_field", ".portfolio-contact_submit"],
          0.055,
          14,
        );

        const aboutWords = document.querySelectorAll<HTMLElement>(
          ".portfolio-about_title [data-reveal-word]",
        );
        if (aboutWords.length) {
          gsap.fromTo(
            aboutWords,
            { opacity: 0.32 },
            {
              opacity: 1,
              stagger: 0.2,
              ease: "none",
              scrollTrigger: {
                trigger: ".portfolio-about_intro",
                start: "top 78%",
                end: "bottom 40%",
                scrub: 0.8,
              },
            },
          );
        }

        gsap.utils
          .toArray<HTMLElement>(".portfolio-project_wrap")
          .forEach((card, index) => {
            gsap.set(card, { zIndex: index + 1 });
            gsap.fromTo(
              card,
              { y: 70, scale: 0.96 },
              {
                y: 0,
                scale: 1,
                ease: "none",
                scrollTrigger: {
                  trigger: card,
                  start: "top 92%",
                  end: "top 52%",
                  scrub: 0.75,
                },
              },
            );
          });
        reveal(".footer_wrap", [".footer_top > *", ".footer_bottom"], 0.07, 14);
      }, document.body);
    };

    const cleanupServiceInteractions = () => {
      serviceInteractionController?.abort();
      serviceInteractionController = undefined;
      gsap.killTweensOf(".portfolio-service_item");
      gsap.set(".portfolio-service_item", {
        clearProps: "opacity,transform",
      });
    };

    const initializeServiceInteractions = () => {
      cleanupServiceInteractions();
      const items = document.querySelectorAll<HTMLElement>(
        ".portfolio-service_item",
      );
      if (!items.length) return;

      gsap.set(items, { clearProps: "opacity,transform" });

      serviceInteractionController = new AbortController();
      const { signal } = serviceInteractionController;
      const reduceMotion = matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      items.forEach((item) => {
        const activate = () => {
          if (item.classList.contains("is-active")) return;
          items.forEach((row) => row.classList.remove("is-active"));
          item.classList.add("is-active");

          if (!reduceMotion) {
            gsap.fromTo(
              item,
              { scale: 0.992 },
              {
                scale: 1,
                duration: 0.45,
                ease: "power2.out",
                overwrite: true,
                clearProps: "transform",
              },
            );
          }
        };

        item.addEventListener("mouseenter", activate, { signal });
        item.addEventListener("focus", activate, { signal });
        item.addEventListener("click", activate, { signal });
      });
    };

    const cleanupPortfolioMotion = () => {
      motionContext?.revert();
      motionContext = undefined;
      cleanupServiceInteractions();
      document
        .querySelector<HTMLElement>(".portfolio_wrap")
        ?.removeAttribute("data-motion-ready");
    };

    initializePortfolioMotion();
    initializeServiceInteractions();
    document.addEventListener("astro:page-load", () => {
      initializePortfolioMotion();
      initializeServiceInteractions();
    });
    document.addEventListener("astro:before-swap", cleanupPortfolioMotion);
    window.addEventListener("pagehide", cleanupPortfolioMotion, { once: true });
    const contactForm =
      document.querySelector<HTMLFormElement>("#contact-form");
    if (contactForm) {
      const submitButton = contactForm.querySelector<HTMLButtonElement>(
        'button[type="submit"]',
      );
      const status = contactForm.querySelector<HTMLElement>(
        ".portfolio-contact_status",
      );
      const messages: Record<string, string> = {
        firstName: "Please enter your first name.",
        lastName: "Please enter your last name.",
        email: "Please enter a valid email address.",
        subject: "Please add a subject.",
        message: "Please tell me a little about your project.",
        privacyConsent: "Please review and accept the Privacy Policy.",
      };
      const validate = (field: HTMLInputElement | HTMLTextAreaElement) => {
        const error = contactForm.querySelector<HTMLElement>(
          `#${field.id}-error`,
        );
        const invalid = !field.validity.valid;
        field.setAttribute("aria-invalid", String(invalid));
        if (error) error.textContent = invalid ? messages[field.name] : "";
        return !invalid;
      };
      contactForm
        .querySelectorAll<HTMLInputElement | HTMLTextAreaElement>(
          ".portfolio-contact_field input, .portfolio-contact_field textarea, .portfolio-contact_consent input",
        )
        .forEach((field) => {
          field.addEventListener("blur", () => validate(field));
          field.addEventListener("input", () => {
            if (field.getAttribute("aria-invalid") === "true") validate(field);
          });
        });
      contactForm.addEventListener("submit", async (event) => {
        event.preventDefault();
        const fields = [
          ...contactForm.querySelectorAll<
            HTMLInputElement | HTMLTextAreaElement
          >(
            ".portfolio-contact_field input, .portfolio-contact_field textarea, .portfolio-contact_consent input",
          ),
        ];
        const valid = fields.map(validate).every(Boolean);
        if (!valid) {
          fields.find((field) => !field.validity.valid)?.focus();
          return;
        }

        if (submitButton) submitButton.disabled = true;
        if (status) status.textContent = "Sending your message...";

        try {
          const formData = new FormData(contactForm);
          const response = await fetch(contactForm.action, {
            method: "POST",
            headers: { "Content-Type": "application/x-www-form-urlencoded" },
            body: new URLSearchParams(
              Array.from(formData.entries(), ([key, value]) => [
                key,
                String(value),
              ]),
            ).toString(),
          });

          if (!response.ok) throw new Error(String(response.status));

          contactForm.reset();
          fields.forEach((field) => field.removeAttribute("aria-invalid"));
          if (status) {
            status.textContent =
              "Thanks - your message was sent. I will be in touch soon.";
          }
        } catch {
          if (status) {
            status.textContent =
              "Your message could not be sent. Please try again.";
          }
        } finally {
          if (submitButton) submitButton.disabled = false;
        }
      });
    }
  </script>

  <style is:global>
    @layer components {
      .portfolio_wrap {
        width: 100%;
        max-width: 100%;
        overflow-x: clip;
        background: var(--background);
        color: var(--text);
      }
      .portfolio-container {
        width: min(calc(100% - 2.5rem), 80rem);
        margin-inline: auto;
      }
      .portfolio-glass-panel {
        --glass-panel-background: color-mix(
          in srgb,
          var(--surface) 64%,
          transparent
        );
        --glass-panel-border: color-mix(in srgb, #ffffff 23%, var(--border));
        --glass-panel-highlight: color-mix(in srgb, #ffffff 24%, transparent);
        --glass-panel-shadow: color-mix(
          in srgb,
          var(--background) 58%,
          transparent
        );
        position: relative;
        isolation: isolate;
        color: var(--text);
        border: 0.0625rem solid var(--glass-panel-border);
        border-radius: 1.5rem;
        background: var(--glass-panel-background);
        box-shadow:
          inset 0.0625rem 0.0625rem 0 var(--glass-panel-highlight),
          inset -0.0625rem -0.0625rem 0
            color-mix(in srgb, var(--border) 62%, transparent),
          0 1.5rem 3.5rem -2rem var(--glass-panel-shadow);
        -webkit-backdrop-filter: blur(1.25rem) saturate(1.18);
        backdrop-filter: blur(1.25rem) saturate(1.18);
      }
      [data-theme="light"] .portfolio-glass-panel {
        --glass-panel-background: color-mix(in srgb, #ffffff 63%, transparent);
        --glass-panel-border: color-mix(in srgb, #ffffff 78%, var(--border));
        --glass-panel-highlight: color-mix(in srgb, #ffffff 88%, transparent);
        --glass-panel-shadow: color-mix(in srgb, #64748b 22%, transparent);
      }
      .portfolio-glass-panel::before {
        position: absolute;
        inset: 0;
