---
import Section from "@/components/Wrapper/Section.astro";
import Heading from "@/components/Typography/Heading.astro";
import Paragraph from "@/components/Typography/Paragraph.astro";
import Eyebrow from "@/components/Typography/Eyebrow.astro";

interface Props {
  /** Set to `false` to skip rendering this component and its children. */
  render?: boolean;
}

const { render = true } = Astro.props;
---

{
  render && (
    <Section
      class="privacy-policy_wrap"
      paddingTop="navoverlap"
      paddingBottom="large"
      gap="large"
      aria-labelledby="privacy-policy-title"
    >
      <header class="privacy-policy_header">
        <Eyebrow>Legal</Eyebrow>
        <Heading
          tag="h1"
          variant="inherit"
          id="privacy-policy-title"
          class="privacy-policy_title"
        >
          Privacy Policy
        </Heading>
        <Paragraph class="privacy-policy_intro">
          This policy explains how Kigudev collects, uses, stores, and protects
          personal information when you visit this website or send a message
          through its contact form.
        </Paragraph>
        <Paragraph variant="small" class="privacy-policy_updated">
          Effective September 26, 2026
        </Paragraph>
      </header>

      <article class="privacy-policy_content">
        <section aria-labelledby="privacy-controller">
          <Heading tag="h2" variant="inherit" id="privacy-controller">
            1. Who is responsible for your information
          </Heading>
          <Paragraph>
            Kigudev, operating in Costa Rica, is responsible for the personal
            information described in this policy. To ask a privacy question or
            exercise your rights, use the <a href="/#contact">contact form</a>.
          </Paragraph>
        </section>

        <section aria-labelledby="privacy-collection">
          <Heading tag="h2" variant="inherit" id="privacy-collection">
            2. Information collected
          </Heading>
          <Paragraph>
            When you submit the contact form, Kigudev collects your first and
            last name, email address, subject, message, and a record of your
            privacy consent. Please do not include sensitive personal
            information in your message.
          </Paragraph>
          <Paragraph>
            This website is hosted by Netlify. Netlify may process technical
            information needed to deliver and secure the site, such as an IP
            address, browser or device information, requested pages, referral
            information, and submission metadata. The site also stores your
            light or dark theme preference in your browser. That preference is
            not used to identify you and can be removed through your browser
            settings.
          </Paragraph>
        </section>

        <section aria-labelledby="privacy-use">
          <Heading tag="h2" variant="inherit" id="privacy-use">
            3. How information is used
          </Heading>
          <Paragraph>Kigudev uses personal information only to:</Paragraph>
          <ul>
            <li>review and respond to your inquiry;</li>
            <li>discuss a potential or active project;</li>
            <li>operate, protect, and troubleshoot the website;</li>
            <li>prevent spam, fraud, misuse, or security incidents; and</li>
            <li>meet applicable legal obligations.</li>
          </ul>
          <Paragraph>
            Kigudev does not sell or rent your personal information and does not
            use contact-form submissions for unsolicited marketing.
          </Paragraph>
        </section>

        <section aria-labelledby="privacy-consent">
          <Heading tag="h2" variant="inherit" id="privacy-consent">
            4. Consent and international processing
          </Heading>
          <Paragraph>
            The contact form asks for your express consent before it can be
            submitted. By providing that consent, you authorize Kigudev to
            process the information for the purposes described above and to use
            service providers that may process information outside Costa Rica.
            You may withdraw your consent at any time, without affecting
            processing that was lawful before withdrawal.
          </Paragraph>
        </section>

        <section aria-labelledby="privacy-sharing">
          <Heading tag="h2" variant="inherit" id="privacy-sharing">
            5. Service providers and disclosure
          </Heading>
          <Paragraph>
            Netlify hosts this website, filters spam, and stores contact-form
            submissions on Kigudev's behalf. Netlify processes information under
            its own security and data-processing terms. Kigudev may also
            disclose information when required by law, to respond to a lawful
            request, or when reasonably necessary to protect the rights,
            property, or safety of Kigudev or others.
          </Paragraph>
          <Paragraph>
            You can review Netlify's{" "}
            <a
              href="https://www.netlify.com/privacy/"
              target="_blank"
              rel="noopener noreferrer"
            >
              privacy statement
            </a>{" "}
            for more information.
          </Paragraph>
        </section>

        <section aria-labelledby="privacy-retention">
          <Heading tag="h2" variant="inherit" id="privacy-retention">
            6. Retention
          </Heading>
          <Paragraph>
            Contact-form submissions are retained for up to 12 months after the
            last interaction and are then deleted when no longer needed. Some
            information may be kept longer when necessary for an active client
            relationship, dispute, accounting requirement, or other legal
            obligation. Hosting and security records are retained according to
            the service provider's applicable schedules. Your theme preference
            remains in your browser until you clear it or replace it.
          </Paragraph>
        </section>

        <section aria-labelledby="privacy-security">
          <Heading tag="h2" variant="inherit" id="privacy-security">
            7. Security
          </Heading>
          <Paragraph>
            Kigudev uses reasonable administrative and technical measures to
            protect personal information. No online transmission or storage
            method is completely secure, so absolute security cannot be
            guaranteed.
          </Paragraph>
        </section>

        <section aria-labelledby="privacy-rights">
          <Heading tag="h2" variant="inherit" id="privacy-rights">
            8. Your privacy rights
          </Heading>
          <Paragraph>
            Under Costa Rica's Law No. 8968, you may request access to your
            personal information and ask for it to be corrected, updated,
            deleted, or blocked. You may also object to processing or withdraw
            consent. Submit a request through the{" "}
            <a href="/#contact">contact form</a> and clearly identify it as a
            privacy request. Kigudev will respond without charge within the
            period required by applicable law, generally five business days.
          </Paragraph>
          <Paragraph>
            You may also contact Costa Rica's data-protection authority, the{" "}
            <a
              href="https://www.prodhab.go.cr/"
              target="_blank"
              rel="noopener noreferrer"
            >
              Agencia de Protección de Datos de los Habitantes (PRODHAB)
            </a>
            .
          </Paragraph>
        </section>

        <section aria-labelledby="privacy-children">
          <Heading tag="h2" variant="inherit" id="privacy-children">
            9. Children's privacy
          </Heading>
          <Paragraph>
            This website and its services are intended for adults and business
            inquiries. Kigudev does not knowingly collect personal information
            from children. If you believe a child has submitted information,
            please request its deletion through the contact form.
          </Paragraph>
        </section>

        <section aria-labelledby="privacy-links">
          <Heading tag="h2" variant="inherit" id="privacy-links">
            10. External links
          </Heading>
          <Paragraph>
            This website links to third-party websites, including scheduling and
            project websites. Their privacy practices are governed by their own
            policies, and Kigudev is not responsible for how those sites handle
            information.
          </Paragraph>
        </section>

        <section aria-labelledby="privacy-changes">
          <Heading tag="h2" variant="inherit" id="privacy-changes">
            11. Changes to this policy
          </Heading>
          <Paragraph>
            Kigudev may update this policy when its practices, service
            providers, or legal obligations change. The effective date at the
            top of this page will be updated when material changes are
            published.
          </Paragraph>
        </section>
      </article>
    </Section>
  )
}

<style is:global>
  @layer components {
    .privacy-policy_wrap {
      color: var(--editorial-foreground);
      background: var(--editorial-surface-alt);
    }

    .privacy-policy_wrap > .container {
      width: min(calc(100% - 3rem), 72rem);
    }

    .privacy-policy_header {
      display: grid;
      gap: 1.5rem;
      padding-bottom: clamp(3rem, 7vw, 6rem);
      border-bottom: 0.0625rem solid var(--editorial-border);
    }

    .privacy-policy_header .eyebrow {
      color: var(--accent);
    }

    .privacy-policy_title {
      max-width: 10ch;
      margin: 0;
      font-family: "Geist", var(--display-family);
      font-size: clamp(3.75rem, 9vw, 8rem);
      font-weight: 700;
      line-height: 0.84;
      letter-spacing: -0.065em;
      text-transform: uppercase;
    }

    .privacy-policy_intro {
      max-width: 52ch;
      margin: 0;
      color: var(--editorial-muted);
      font-size: clamp(1.1rem, 1.8vw, 1.35rem);
      line-height: 1.6;
    }

    .privacy-policy_updated {
      margin: 0;
      color: var(--editorial-subtle);
      font-family: "JetBrains Mono", monospace;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .privacy-policy_content {
      display: grid;
      gap: 0;
      max-width: 52rem;
      margin-left: auto;
    }

    .privacy-policy_content section {
      display: grid;
      gap: 1.25rem;
      padding-block: clamp(2.5rem, 5vw, 4.5rem);
      border-bottom: 0.0625rem solid var(--editorial-border);
    }

    .privacy-policy_content section:last-child {
      border-bottom: 0;
    }

    .privacy-policy_content h2 {
      max-width: 22ch;
      margin: 0;
      color: var(--editorial-foreground);
      font-family: "Geist", var(--display-family);
      font-size: clamp(1.6rem, 3vw, 2.5rem);
      font-weight: 600;
      line-height: 1.05;
      letter-spacing: -0.035em;
    }

    .privacy-policy_content .text,
    .privacy-policy_content li {
      margin: 0;
      color: var(--editorial-muted);
      font-size: 1rem;
      line-height: 1.75;
    }

    .privacy-policy_content ul {
      display: grid;
      gap: 0.5rem;
      margin: 0;
      padding-left: 1.25rem;
    }

    .privacy-policy_content a {
      color: var(--editorial-foreground);
      text-decoration-color: var(--accent);
      text-decoration-thickness: 0.1em;
      text-underline-offset: 0.2em;
    }

    .privacy-policy_content a:hover {
      color: var(--accent);
    }

    .privacy-policy_content a:focus-visible {
      outline: 0.125rem solid var(--accent);
      outline-offset: 0.25rem;
    }

    @media (width < 48rem) {
      .privacy-policy_wrap > .container {
        width: calc(100% - 2rem);
      }

      .privacy-policy_title {
        font-size: clamp(3.25rem, 18vw, 5.25rem);
      }
    }
  }
</style>
