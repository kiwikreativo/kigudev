---
import { Image } from "astro:assets";
import Heading from "@/components/Typography/Heading.astro";
import CarmenPic from "@/assets/Carmen-profile-pic.webp";
import JossPic from "@/assets/jossprof.webp";

type Testimonial = {
  quote: string;
  name: string;
  role: string;
  image?: ImageMetadata;
};

const testimonials: Testimonial[] = [
  {
    quote:
      "Guillermo strikes the perfect balance between flexibility, simplicity, and visual consistency.",
    name: "Carmen Cerna",
    role: "Founder, Meguis Import&Export",
    image: CarmenPic,
  },
  {
    quote:
      "Clean layouts, responsive design, and thoughtful communication made the whole process incredibly valuable.",
    name: "Jocselyn Segura",
    role: "Founder, DecorazonJoss",
    image: JossPic,
  },
  {
    quote:
      "This project helped us launch faster with a beautiful digital experience that feels completely ours.",
    name: "Kattia Altamirano",
    role: "Founder & CEO, Kalta Agency",
  },
];
---

<section
  class="home-testimonials_wrap"
  aria-labelledby="testimonials-title"
>
  <div class="home-testimonials_inner">
    <header class="home-testimonials_header">
      <p class="home-testimonials_kicker">Testimonials</p>
      <Heading
        tag="h2"
        variant="inherit"
        id="testimonials-title"
        class="home-testimonials_title"
      >
        Loved by builders everywhere
      </Heading>
      <p class="home-testimonials_intro">
        Don&rsquo;t take my word for it &mdash; here&rsquo;s what founders I&rsquo;ve
        worked with have to say.
      </p>
    </header>

    <div class="home-testimonials_list">
      {
        testimonials.map((testimonial) => (
          <figure class="home-testimonial_card">
            <span class="home-testimonial_cross" aria-hidden="true" />
            <blockquote class="home-testimonial_quote">
              <i class="ph ph-quotes" aria-hidden="true" />
              <p>{testimonial.quote}</p>
            </blockquote>
            <figcaption class="home-testimonial_author">
              {testimonial.image && (
                <Image
                  src={testimonial.image}
                  alt={`${testimonial.name}'s profile picture`}
                  width={48}
                  height={48}
                  loading="lazy"
                />
              )}
              <span class="home-testimonial_identity">
                <cite>{testimonial.name}</cite>
                <span>{testimonial.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  @layer components {
    .home-testimonials_wrap {
      padding-block: clamp(5rem, 10vw, 9rem);
      color: var(--text);
    }

    .home-testimonials_inner {
      display: grid;
      width: min(calc(100% - 2.5rem), 80rem);
      margin-inline: auto;
      gap: clamp(4rem, 8vw, 7rem);
    }

    .home-testimonials_header {
      display: grid;
      max-width: 42rem;
      margin-inline: auto;
      justify-items: center;
      gap: 1.25rem;
      text-align: center;
    }

    .home-testimonials_kicker {
      margin: 0;
      color: var(--accent);
      font-family: var(--label-family);
      font-size: 0.75rem;
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .home-testimonials_title {
      max-width: 14ch;
      margin: 0;
      font-family: var(--display-family);
      font-size: clamp(2.75rem, 6vw, 5.5rem);
      font-weight: 500;
      line-height: 0.92;
      letter-spacing: -0.045em;
      text-wrap: balance;
    }

    .home-testimonials_intro {
      max-width: 38rem;
      margin: 0;
      color: var(--text-secondary);
      font-size: clamp(0.95rem, 1.4vw, 1.08rem);
      line-height: 1.65;
      text-wrap: balance;
    }

    .home-testimonials_list {
      display: grid;
      border-top: 0.0625rem solid var(--border);
    }

    .home-testimonial_card {
      position: relative;
      display: flex;
      min-width: 0;
      min-height: 21rem;
      margin: 0;
      padding: clamp(2rem, 7vw, 3rem);
      flex-direction: column;
      justify-content: space-between;
      gap: 3rem;
      border-right: 0.0625rem solid var(--border);
      border-bottom: 0.0625rem solid var(--border);
      border-left: 0.0625rem solid var(--border);
      background: color-mix(in srgb, var(--surface) 52%, transparent);
      transition: background-color 250ms ease;
    }

    .home-testimonial_card:hover {
      background: color-mix(in srgb, var(--surface) 78%, transparent);
    }

    .home-testimonial_cross {
      position: absolute;
      top: 0;
      left: 0;
      width: 0.875rem;
      aspect-ratio: 1;
      color: var(--text-secondary);
      transform: translate(-50%, -50%);
    }

    .home-testimonial_cross::before,
    .home-testimonial_cross::after {
      position: absolute;
      content: "";
      background: currentcolor;
    }

    .home-testimonial_cross::before {
      top: 50%;
      left: 0;
      width: 100%;
      height: 0.0625rem;
    }

    .home-testimonial_cross::after {
      top: 0;
      left: 50%;
      width: 0.0625rem;
      height: 100%;
    }

    .home-testimonial_quote {
      display: grid;
      margin: 0;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 1rem;
      align-items: start;
    }

    .home-testimonial_quote i {
      color: var(--accent);
      font-size: 1.5rem;
      line-height: 1;
    }

    .home-testimonial_quote p {
      margin: 0;
      color: var(--text-secondary);
      font-size: clamp(1rem, 1.7vw, 1.12rem);
      line-height: 1.65;
      overflow-wrap: break-word;
    }

    .home-testimonial_author {
      display: flex;
      min-width: 0;
      gap: 1rem;
      align-items: center;
    }

    .home-testimonial_author :global(img) {
      width: 3rem;
      height: 3rem;
      flex: none;
      border: 0.125rem solid var(--background);
      border-radius: 50%;
      box-shadow: 0 0 0 0.0625rem var(--border);
      object-fit: cover;
    }

    .home-testimonial_identity {
      display: grid;
      min-width: 0;
      gap: 0.25rem;
    }

    .home-testimonial_identity cite {
      color: var(--text);
      font-size: 0.9rem;
      font-style: normal;
      font-weight: 600;
      line-height: 1.3;
    }

    .home-testimonial_identity span {
      color: var(--text-secondary);
      font-size: 0.75rem;
      line-height: 1.45;
      overflow-wrap: break-word;
    }

    @media (width >= 48rem) {
      .home-testimonials_list {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-bottom: 0.0625rem solid var(--border);
      }

      .home-testimonial_card {
        min-height: 24rem;
        padding: clamp(1.75rem, 3vw, 2.5rem);
        border-bottom: 0;
        border-left: 0;
      }

      .home-testimonial_card:first-child {
        border-left: 0.0625rem solid var(--border);
        transform: translateY(-2rem);
      }

      .home-testimonial_card:last-child {
        transform: translateY(2rem);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .home-testimonial_card {
        transition: none;
      }
    }
  }
</style>
