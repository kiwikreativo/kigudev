---
import Layout from "@/layouts/BaseLayout.astro";
import ContentProjectsIndex from "@/components/Portfolio/ContentProjectsIndex.astro";
import { projects } from "@/data/projects.ts";
import { SITE_URL } from "@/consts.ts";
import { breadcrumbSchema, entityIds } from "@/utils/structuredData.ts";
const canonical = `${SITE_URL}/projects/`;
const structuredData = { "@context": "https://schema.org", "@graph": [
  { "@type": "CollectionPage", "@id": `${canonical}#webpage`, url: canonical, name: "Web Design and Development Projects", isPartOf: { "@id": entityIds.website }, mainEntity: { "@type": "ItemList", itemListElement: projects.map((project, index) => ({ "@type": "ListItem", position: index + 1, url: `${SITE_URL}/projects/${project.slug}/`, name: project.title })) } },
  breadcrumbSchema([{ name: "Home", url: `${SITE_URL}/` }, { name: "Projects", url: canonical }]),
] };
---
<Layout theme="dark" title="Web Design and Development Projects" description="Explore Kiguidev case studies spanning business websites, product landing pages, developer tools, and Web3 interfaces.">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <ContentProjectsIndex />
</Layout>
