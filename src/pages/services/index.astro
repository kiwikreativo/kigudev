---
import Layout from "@/layouts/BaseLayout.astro";
import ContentServicesIndex from "@/components/Portfolio/ContentServicesIndex.astro";
import { services } from "@/data/services.ts";
import { SITE_URL } from "@/consts.ts";
import { breadcrumbSchema, entityIds } from "@/utils/structuredData.ts";
const canonical = `${SITE_URL}/services/`;
const structuredData = { "@context": "https://schema.org", "@graph": [
  { "@type": "CollectionPage", "@id": `${canonical}#webpage`, url: canonical, name: "Web Design and Development Services", isPartOf: { "@id": entityIds.website }, mainEntity: { "@type": "ItemList", itemListElement: services.map((service, index) => ({ "@type": "ListItem", position: index + 1, url: `${SITE_URL}/services/${service.slug}/`, name: service.title })) } },
  breadcrumbSchema([{ name: "Home", url: `${SITE_URL}/` }, { name: "Services", url: canonical }]),
] };
---
<Layout theme="dark" title="Web Design and Development Services" description="Explore Kiguidev services for UI/UX design, web development, mobile enhancement, and technical SEO from Costa Rica for local and remote US clients.">
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <ContentServicesIndex />
</Layout>
